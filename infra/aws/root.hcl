/**
 * Root Terragrunt configuration — AWS.
 *
 * The AWS twin of `infra/gcp/root.hcl`. Separate on purpose rather than one
 * clever shared file with conditionals in it: the two clouds need different
 * backends (S3 vs GCS), different providers, and different version pins, and a
 * single file juggling both would be harder to read than two files that each
 * do one thing. The folder layout under each is deliberately identical, so
 * knowing your way around one means knowing your way around the other.
 *
 * Everything under live/ includes this, so the backend and the provider are
 * declared once rather than copied into every unit.
 *
 * State lives in an S3 bucket, never on a laptop — same reasoning as the GCP
 * side: it is the only record of what actually exists in AWS, and it holds
 * resource detail that should not sit in a working directory. The bucket and
 * its lock table are created once by the AWS CLI before the first apply (see
 * SETUP.md); Terraform cannot create the thing it stores its own state in.
 */

locals {
  env_vars    = read_terragrunt_config(find_in_parent_folders("env.hcl"))
  region_vars = read_terragrunt_config(find_in_parent_folders("region.hcl"))

  account_id   = local.env_vars.locals.account_id
  state_bucket = local.env_vars.locals.state_bucket
  lock_table   = local.env_vars.locals.lock_table
  env          = local.env_vars.locals.env

  /*
   * The region every unit under this folder builds in.
   *
   * An AWS VPC belongs to ONE region, and so does everything hanging off it:
   * subnets, security groups, NAT gateways, machine images. There is no such
   * thing as a network that spans regions here — unlike Google, where one
   * network covers them all.
   *
   * So the region comes from the folder, not from a single `default_region`
   * at the top of the environment. That setting is what made this stack
   * single-region: `regions` listed three, and only `regions[default_region]`
   * was ever read, so two of the three platform regions had no infrastructure
   * at all and a deployment into them failed at launch.
   */
  region = local.region_vars.locals.region
  azs    = local.region_vars.locals.azs
}

remote_state {
  backend = "s3"

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }

  config = {
    bucket = local.state_bucket
    # The bucket itself lives in one place; which region a unit BUILDS in is a
    # separate thing, and is part of the key below.
    region = local.env_vars.locals.state_bucket_region

    # One state file per unit, keyed by its path under live/. Keeping network,
    # security and nat in separate states means a mistake while editing one
    # cannot corrupt or lock the others — and the security unit, which IS the
    # isolation, can be applied on its own.
    #
    # The path now includes the region folder, so the same unit in two regions
    # gets two states and two locks. Without that they would share one, and
    # applying eu-west-1 would destroy what us-east-1 had built.
    key = "${path_relative_to_include()}/terraform.tfstate"

    # State describes live infrastructure, so it is encrypted at rest and the
    # bucket is never public. Belt and braces, in case the bucket was created
    # by hand without them.
    encrypt = true

    # Two clients running apply at once would interleave writes and leave the
    # state describing neither reality. DynamoDB holds the lock.
    dynamodb_table = local.lock_table
  }
}

generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<-EOF
    provider "aws" {
      region = "${local.region}"

      # Refuse to run against the wrong account. Without this, a stale profile
      # or an exported key from another account applies happily — and the first
      # sign is customer machines in a place nothing is watching.
      allowed_account_ids = ["${local.account_id}"]

      default_tags {
        tags = {
          managed-by  = "terragrunt"
          platform    = "aiocean"
          environment = "${local.env}"
        }
      }
    }
  EOF
}

/*
 * There is deliberately no `generate "versions"` here.
 *
 * Every module under modules/ declares its own `versions.tf`, which is what a
 * reusable module should do — it states the provider it needs rather than
 * trusting whatever the caller happened to configure.
 *
 * Generating a second one on top of that does not overwrite it:
 * `if_exists = "overwrite_terragrunt"` only replaces files Terragrunt itself
 * wrote, and a file copied in from the module source is not one. The result
 * was that every single unit failed before Terraform even started, with
 * "versions.tf already exists and was not generated by terragrunt" — so this
 * stack had never run `validate`, let alone an apply.
 *
 * The provider block below is a different matter and does belong here: its
 * region and allowed account are per-environment, which a shared module
 * cannot know.
 */

inputs = {
  environment = local.env
}
