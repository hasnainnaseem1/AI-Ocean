PORT=3002
# Backend API URL
REACT_APP_API_URL=http://localhost:3001
# Marketing Website URL
REACT_APP_MARKETING_URL=http://localhost:3000
# Google OAuth Client ID (from https://console.cloud.google.com)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# In production, change to:
# REACT_APP_API_URL=https://api.sellsera.com
# REACT_APP_MARKETING_URL=https://www.sellsera.com