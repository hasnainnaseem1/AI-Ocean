  navigationLabel  String  @default("") @map("navigation_label")

  blocks MarketingPageBlock[] @relation("MarketingPageBlocks")

  customCSS String @default("") @map("custom_css")

  lastEditedById String? @map("last_edited_by_id") @db.Uuid
  lastEditedBy   User?   @relation("MarketingPageLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug, status])
  @@index([showInNavigation, navigationOrder])
  @@map("marketing_pages")
}

// Addressed directly, so it carries its own id. The
// source's own `order` field already IS the array-position column (rule #5),
// so no separate synthetic column is added on top of it. `items` stays Json:
// item shape varies per block type and is rendered generically by the
// frontend — not worth a second child table (per plan).
model MarketingPageBlock {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  pageId String        @map("page_id") @db.Uuid
  page   MarketingPage @relation("MarketingPageBlocks", fields: [pageId], references: [id], onDelete: Cascade)

  order Int @default(0)

  type MarketingBlockType

  title               String @default("")
  subtitle            String @default("")
  content             String @default("")
  buttonText          String @default("") @map("button_text")
  buttonLink          String @default("") @map("button_link")
  secondaryButtonText String @default("") @map("secondary_button_text")
  secondaryButtonLink String @default("") @map("secondary_button_link")
  backgroundImage     String @default("") @map("background_image")
  backgroundColor     String @default("") @map("background_color")
  textColor           String @default("") @map("text_color")

  items Json?

  visible  Boolean @default(true)
  settings Json?

  @@index([pageId, order])
  @@map("marketing_page_blocks")
}

// `options[]` and `signalRules[]` stay Json per the plan — 3-4 levels deep,
// shape varies by question type, never queried relationally. This is also
// where the deeply-nested `signalSchema` (min/max hardware floors, use-case
// preference weights, scoring nudges) lives, folded into whichever of the
// two Json blobs it appears under.
model QuestionTemplate {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  key         String @unique
  question    String
  helpText    String @default("") @map("help_text")
  placeholder String @default("")

  type QuestionType @default(select)

  options     Json?
  signalRules Json? @map("signal_rules")

  // Derived in the app from the signals actually present — never trusted
  // from the client.
  affectsSizing Boolean @default(false) @map("affects_sizing")

  required     Boolean @default(false)
  defaultValue Json?   @map("default_value")

  // appliesTo{} flattened. `modelIds` was a real ObjectId-ref array in
  // a real relation (unlike this app's usual soft string references) — kept as a
  // plain String[] with no relation constraint for now; flagged for human
  // review, see the migration report.
  appliesToAllModels  Boolean  @default(true) @map("applies_to_all_models")
  appliesToModelIds   String[] @default([]) @map("applies_to_model_ids")
  appliesToModalities String[] @default([]) @map("applies_to_modalities")

  // dependsOn{} flattened
  dependsOnQuestionKey String @default("") @map("depends_on_question_key")
  dependsOnEquals      Json?  @map("depends_on_equals")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("QuestionTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("QuestionTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([displayOrder])
  @@index([affectsSizing])
  @@map("question_templates")
}

// How the recommendation engine makes up its mind. Deliberately dumb
// storage: every nested tuning block (modelRanking/tierScoring/suitability/
// confidence/matchReasonLimits) and every open-vocabulary weight/template map
// collapses to its own Json column — the engine deep-merges whatever is set
// over services/recommendation/policyDefaults.js, so a policy that overrides
// one field never blanks out the rest, and a policy written before a new
// knob existed keeps working. Flagged for human review: the defined-shape
// nested sections (modelRanking etc.) have a fixed shape, so a
// stricter reading of the plan's rules could flatten them into dozens of
// individual columns instead — Json was chosen here because they are
// single-purpose tuning blobs never queried relationally, read/written only
// as a whole by the recommendation engine, much like AdminSettings' sections.
model RecommendationPolicy {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  key         String @unique
  name        String
  description String @default("")

  // "Exactly one active" used to be enforced in application code. Prisma's
  // schema DSL cannot express a partial unique index directly, so this is
  // enforced by a hand-written partial unique index instead (migration
  // 20260906114845_recommendation_policy_single_active) rather than here.
  isActive Boolean @default(false) @map("is_active")

  modelRanking Json? @map("model_ranking")
  tierScoring  Json? @map("tier_scoring")
  suitability  Json?

  fitWeights     Json? @map("fit_weights")
  uptimeRanks    Json? @map("uptime_ranks")
  confidence     Json?
  modalityLabels Json? @map("modality_labels")

  reasonTemplates      Json? @map("reason_templates")
  suitabilityTemplates Json? @map("suitability_templates")
  tierIssueTemplates   Json? @map("tier_issue_templates")
  matchReasonTemplates Json? @map("match_reason_templates")
  alternativeTemplates Json? @map("alternative_templates")
  blockerTemplates     Json? @map("blocker_templates")

  matchReasonLimits Json? @map("match_reason_limits")

  cacheTtlSeconds Int? @map("cache_ttl_seconds")

  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("RecommendationPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recommendation_policies")
}

model SeoRedirect {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  fromPath String @unique @map("from_path")
  toPath   String @map("to_path")

  // Allowed values validated in app code: 301, 302, 307, 308.
  statusCode Int @default(301) @map("status_code")

  isActive  Boolean   @default(true) @map("is_active")
  hitCount  Int       @default(0) @map("hit_count")
  lastHitAt DateTime? @map("last_hit_at")
  note      String    @default("")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("SeoRedirectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seo_redirects")
}
