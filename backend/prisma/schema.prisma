}

/**
 * Where a real cloud machine is in its life.
 * Deliberately NOT the same vocabulary as DeploymentStatus, and deliberately
 * not derived from it. A deployment's status is a promise to the customer; this
 * is a fact about hardware, and the two genuinely differ — a machine can be
 * `running` on GCP for half an hour while the deployment is still
 * `provisioning`, because the model inside it is not configured yet. That gap
 * is exactly the window the platform is paying Google for, which is why the
 * compute clock starts here rather than on the deployment status.
 * planned      the shape has been decided, nothing has been asked of GCP yet
 * creating     instances.insert accepted; the long-running operation is open
 * running      GCP reports RUNNING — this is where billing starts
 * stopping     a stop or delete has been requested
 * stopped      the machine is off; its disk still exists and still costs
 * terminated   the machine and its disk are gone
 * failed       GCP refused, and a human has to change something
 */
enum CloudInstancePhase {
  planned
  creating
  running
  stopping
  stopped
  terminated
  failed
}

enum BillingMethod {
  prepaid
  payg
}

