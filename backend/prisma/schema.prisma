// ============================================================================
// AI-Ocean backend — PostgreSQL schema (Prisma)
//
// Primary keys: every table gets a native Postgres `uuid` column, generated
// by Postgres itself via `gen_random_uuid()`. On Postgres 13+ (this project
// targets the latest stable, currently 18, per Docker container) that
// function ships in core — no `pgcrypto` extension needed. Only pre-13
// Postgres would require `CREATE EXTENSION pgcrypto`.
//
// That uuid is also the public id: it is what the API returns as `id` and what
// every route accepts back. There is no second id column.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL no longer lives here — it's supplied to the
// Migrate CLI via prisma.config.js and to PrismaClient at runtime via the
// @prisma/adapter-pg driver adapter (see src/lib/prismaClient.js).
datasource db {
  provider = "postgresql"
}

// ============================================================================
// ==== Enums ====
// ============================================================================

// -- User --
enum AccountType {
  customer
  admin
}

enum Role {
  customer
  super_admin
  admin
  moderator
  viewer
  custom
}

enum UserStatus {
  pending_verification
  active
  suspended
  banned
  inactive
}

// -- Teams --
// Who owns money on this platform. Every customer has exactly one `personal`
// account (created at signup, 1 member, shown simply as "Personal"), and may
// own or belong to any number of `team` accounts. See the Team model.
enum TeamKind {
  personal
  team
}

enum TeamRole {
  owner
  admin
  billing
  developer
  viewer
}

// -- Catalog --
enum ComponentKind {
  gpu
  cpu
  memory
  storage
  network
  other
}

enum PricingPeriod {
  hour
  month
}

enum PricingMode {
  components
  flat
}

enum TierStatus {
  available
  limited
  out_of_stock
}

enum ModelFamily {
  kimi
  deepseek
  llama
  qwen
  mistral
  gemma
  phi
  falcon
  custom
}

enum Modality {
  chat
  completion
  vision
  image_generation
  embedding
  audio
  code
}

enum ModelUseCaseFit {
