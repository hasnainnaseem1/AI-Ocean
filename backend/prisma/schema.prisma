// ============================================================================
// ==== User domain ====
// ============================================================================

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name     String
  email    String @unique
  phone    String @default("")
  password String

  accountType AccountType @default(customer) @map("account_type")
  role        Role        @default(customer)

  customRoleId String?     @map("custom_role_id") @db.Uuid
  customRole   CustomRole? @relation("UserCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)

  status UserStatus @default(pending_verification)

  isEmailVerified          Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken   String?   @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")

  // Unused dead weight — LemonSqueezy's checkout is stateless per-transaction
  // and needs no stored customer id.
  lemonSqueezyCustomerId String? @map("lemon_squeezy_customer_id")

  // stripeCustomerId / polarCustomerId, disputeHold and paygAccess used to
  // live here. They describe the account that pays — its card, a chargeback on
  // it, whether it may run a tab — so they moved to Team with the money.

  // Admin-specific fields
  department  String? // soft reference to Department.value, never a real FK
  permissions Json? // an open-ended permission map

  assignedById String? @map("assigned_by_id") @db.Uuid
  assignedBy   User?   @relation("UserAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  avatar String?

  googleId String? @unique @map("google_id") // unique when set; Postgres allows many NULLs

  lastLogin   DateTime? @map("last_login")
  lastLoginIP String?   @map("last_login_ip")

  loginAttempts Int       @default(0) @map("login_attempts")
  lockUntil     DateTime? @map("lock_until")

  timezone String @default("UTC")

  // Which language the customer center renders for this user, and whether they
  // have ever actually chosen one. The two are separate because "en" is both
  // the default and a legitimate deliberate choice — without the flag there is
  // no way to tell a user who picked English from one who was never asked, and
  // the first-run language prompt would nag the former forever.
  //
  // Deliberately a plain String and not an enum: which languages are live is an
  // admin setting (AdminSettings.features.languages), so an enum would mean a
  // migration every time an operator adds one — the exact thing this feature
  // exists to avoid.
  language              String  @default("en")
  languagePreferenceSet Boolean @default(false) @map("language_preference_set")

  // Chose "my team / company" at signup and has not yet finished (or skipped)
  // creating their organization. Drives the post-signup onboarding; an
  // individual signup leaves it false and sees nothing new.
  teamOnboardingPending Boolean @default(false) @map("team_onboarding_pending")

  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  resetPasswordRequestedById String? @map("reset_password_requested_by_id") @db.Uuid
  resetPasswordRequestedBy   User?   @relation("UserResetPasswordRequestedBy", fields: [resetPasswordRequestedById], references: [id], onDelete: SetNull)

  resetPasswordRequestedAt DateTime? @map("reset_password_requested_at")
  passwordChangeRequired   Boolean   @default(false) @map("password_change_required")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ---- self-relation back-arrays ----
  assignedUsers                 User[] @relation("UserAssignedBy")
  resetPasswordRequestedByUsers User[] @relation("UserResetPasswordRequestedBy")

  // ---- back-relations for createdBy/updatedBy/etc. across other models ----
  createdCustomRoles                    CustomRole[]                     @relation("CustomRoleCreatedBy")
  updatedCustomRoles                    CustomRole[]                     @relation("CustomRoleUpdatedBy")
  createdUseCaseTags                    UseCaseTag[]                     @relation("UseCaseTagCreatedBy")
  updatedUseCaseTags                    UseCaseTag[]                     @relation("UseCaseTagUpdatedBy")
  createdTierCategories                 TierCategory[]                   @relation("TierCategoryCreatedBy")
  updatedTierCategories                 TierCategory[]                   @relation("TierCategoryUpdatedBy")
  createdResourceComponents             ResourceComponent[]              @relation("ResourceComponentCreatedBy")
  updatedResourceComponents             ResourceComponent[]              @relation("ResourceComponentUpdatedBy")
  createdTiers                          Tier[]                           @relation("TierCreatedBy")
  updatedTiers                          Tier[]                           @relation("TierUpdatedBy")
  createdAIModels                       AIModel[]                        @relation("AIModelCreatedBy")
  updatedAIModels                       AIModel[]                        @relation("AIModelUpdatedBy")
  createdTeams                          Team[]                           @relation("TeamCreatedBy")
  teamMemberships                       TeamMember[]                     @relation("TeamMemberUser")
  invitedTeamMembers                    TeamMember[]                     @relation("TeamMemberInvitedBy")
  sentTeamInvitations                   TeamInvitation[]                 @relation("TeamInvitationInvitedBy")
  teamActivity                          TeamActivity[]                   @relation("TeamActivityActor")
  ownershipTransfersOffered             OwnershipTransfer[]              @relation("OwnershipTransferFrom")
  ownershipTransfersReceived            OwnershipTransfer[]              @relation("OwnershipTransferTo")
  teamJoinRequests                      TeamJoinRequest[]                @relation("TeamJoinRequestUser")
  teamJoinRequestsDecided               TeamJoinRequest[]                @relation("TeamJoinRequestDecidedBy")
  teamJoinLinks                         TeamJoinLink[]                   @relation("TeamJoinLinkCreatedBy")
  creditTransactions                    CreditTransaction[]              @relation("CreditTransactionUser")
  createdCreditTransactions             CreditTransaction[]              @relation("CreditTransactionCreatedBy")
  paymentMethods                        PaymentMethod[]                  @relation("PaymentMethodUser")
  payments                              Payment[]                        @relation("PaymentUser")
  deployments                           Deployment[]                     @relation("DeploymentUser")
  assignedDeployments                   Deployment[]                     @relation("DeploymentAssignedTo")
  shutdownDeployments                   Deployment[]                     @relation("DeploymentShutdownCompletedBy")
  deploymentUsages                      DeploymentUsage[]                @relation("DeploymentUsageUser")
  deploymentStatusHistoryEntries        DeploymentStatusHistory[]        @relation("DeploymentStatusHistoryBy")
  deploymentBillingMethodHistoryEntries DeploymentBillingMethodHistory[] @relation("DeploymentBillingMethodHistoryActor")
  receivedNotifications                 Notification[]                   @relation("NotificationRecipient")
  sentNotifications                     Notification[]                   @relation("NotificationSender")
  activityLogs                          ActivityLog[]                    @relation("ActivityLogUser")
  blogPosts                             BlogPost[]                       @relation("BlogPostAuthor")
  createdCronJobs                       CronJob[]                        @relation("CronJobCreatedBy")
  customerNotes                         CustomerNote[]                   @relation("CustomerNoteCustomer")
  authoredCustomerNotes                 CustomerNote[]                   @relation("CustomerNoteAuthor")
  supportTickets                        SupportTicket[]                  @relation("SupportTicketUser")
  assignedSupportTickets                SupportTicket[]                  @relation("SupportTicketAssignedAdmin")
  authoredSupportTicketMessages         SupportTicketMessage[]           @relation("SupportTicketMessageAuthor")
  supportTicketStatusChanges            SupportTicketStatusHistory[]     @relation("SupportTicketStatusHistoryBy")
  createdDepartments                    Department[]                     @relation("DepartmentCreatedBy")
  updatedDepartments                    Department[]                     @relation("DepartmentUpdatedBy")
  createdDeploymentJourneys             DeploymentJourney[]              @relation("DeploymentJourneyCreatedBy")
  updatedDeploymentJourneys             DeploymentJourney[]              @relation("DeploymentJourneyUpdatedBy")
  editedMarketingPages                  MarketingPage[]                  @relation("MarketingPageLastEditedBy")
  createdQuestionTemplates              QuestionTemplate[]               @relation("QuestionTemplateCreatedBy")
  updatedQuestionTemplates              QuestionTemplate[]               @relation("QuestionTemplateUpdatedBy")
  updatedRecommendationPolicies         RecommendationPolicy[]           @relation("RecommendationPolicyUpdatedBy")
  updatedAnalyticsPolicies              AnalyticsPolicy[]                @relation("AnalyticsPolicyUpdatedBy")
  createdSeoRedirects                   SeoRedirect[]                    @relation("SeoRedirectCreatedBy")
  resolvedOrphanInstances               OrphanInstance[]                 @relation("OrphanInstanceResolvedBy")

  /**
   * ── Analytics indexes ──
   * Every `@@index` below carrying an explicit `map:` exists to support the
   * admin analytics layer, and the name is pinned so it matches the index the
   * migration already created by hand.
   * They are declared here, and not only in SQL, on purpose. They were added
   * as raw `CREATE INDEX` statements first (hand-written migrations are this
   * project's convention) and left out of this schema — which made the schema
   * claim they did not exist. Anybody running `prisma db push`, or generating a
   * migration from a schema diff, would have silently dropped all twenty-two of
   * them, and nothing would have failed: the dashboard would just have started
   * reading `users` and `deployment_usages` end to end.
   */
  @@index([createdAt(sort: Desc)], map: "users_created_at_idx")
  @@index([accountType, status], map: "users_account_type_status_idx")
  // Dormancy is the strongest churn signal and is a range scan on this column.
  @@index([lastLogin(sort: Desc)], map: "users_last_login_idx")
  @@map("users")
}

model CustomRole {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String   @unique
  description String?
  permissions String[]
  isActive    Boolean  @default(true) @map("is_active")

  // Nullable + SetNull so deleting the admin who created a role doesn't make
  // that admin undeletable. Matches `updatedById` below and every other
  // created_by/updated_by column in this schema.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("CustomRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("CustomRoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[] @relation("UserCustomRole")

  @@map("custom_roles")
}

// ============================================================================
// ==== Catalog domain ====
// ============================================================================

model UseCaseTag {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  key         String @unique
  label       String
  description String @default("")
  icon        String @default("")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("UseCaseTagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("UseCaseTagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([displayOrder])
  @@map("use_case_tags")
}

model TierCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String  @unique
  slug        String? @unique
  description String  @default("")
  icon        String  @default("")
  color       String  @default("")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("TierCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("TierCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiers Tier[] @relation("TierTierCategory")

  @@index([slug])
  @@index([displayOrder])
  @@map("tier_categories")
}

model ResourceComponent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String        @unique
  slug        String?       @unique
  kind        ComponentKind
  description String        @default("")
  unitLabel   String        @default("unit") @map("unit_label")

  // What the admin typed, in the period they chose
  pricePerUnit        Decimal       @map("price_per_unit") @db.Decimal(12, 6)
  pricingPeriod       PricingPeriod @default(hour) @map("pricing_period")
  // Normalised hourly figure everything else reads. Derived on save by the
  // pricing service — six decimals, since a per-GB-hour disk price is
  // genuinely that small (0.00012 rounded to four would be a 17% error).
  pricePerUnitPerHour Decimal       @default(0) @map("price_per_unit_per_hour") @db.Decimal(12, 6)
  // Snapshotted from billing settings at save time so a later settings change
  // cannot silently reprice every machine on the platform.
  hoursPerMonth       Int           @default(730) @map("hours_per_month")

  currency String @default("USD")

  billedWhileStopped Boolean @default(false) @map("billed_while_stopped")

  minQuantity  Int @default(1) @map("min_quantity")
  maxQuantity  Int @default(0) @map("max_quantity")
  stepQuantity Int @default(1) @map("step_quantity")

  specs Json?

  availableForCustomBuilds Boolean @default(true) @map("available_for_custom_builds")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("ResourceComponentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("ResourceComponentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tierComponents TierComponent[] @relation("TierComponentResourceComponent")

  @@index([slug])
  @@index([kind, displayOrder])
  @@index([isActive])
  @@map("resource_components")
}

model Tier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String  @unique
  slug        String? @unique
  description String  @default("")

  categoryId String?       @map("category_id") @db.Uuid
  category   TierCategory? @relation("TierTierCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  components TierComponent[] @relation("TierComponents")

  // ── Pricing ──
  pricingMode                            PricingMode @default(flat) @map("pricing_mode")
  pricingFlatPricePerHour                Decimal     @default(0) @map("pricing_flat_price_per_hour") @db.Decimal(12, 4)
  pricingFlatStoppedPricePerHour         Decimal     @default(0) @map("pricing_flat_stopped_price_per_hour") @db.Decimal(12, 4)
  pricingMarkupPercent                   Decimal     @default(0) @map("pricing_markup_percent") @db.Decimal(7, 4)
  pricingComponentSubtotalPerHour        Decimal     @default(0) @map("pricing_component_subtotal_per_hour") @db.Decimal(12, 4)
  pricingComponentStoppedSubtotalPerHour Decimal     @default(0) @map("pricing_component_stopped_subtotal_per_hour") @db.Decimal(12, 4)

  // Final derived rates — every read path (catalog, sizing engine, billing) reads these
  pricePerHour        Decimal @default(0) @map("price_per_hour") @db.Decimal(12, 4)
  stoppedPricePerHour Decimal @default(0) @map("stopped_price_per_hour") @db.Decimal(12, 4)

  /// What this tier should earn over its cost, as a percentage.
  ///
  /// The one number an operator sets to price this tier everywhere: the hourly
  /// refresh works out what the machine costs on each cloud in each region and
  /// adds this on top, filling the whole `prices` table from it.
  ///
  /// Null means "use the platform default" from `cloudPricingSettings`, so a
  /// business-wide change to the target margin reaches every tier that has not
  /// deliberately been given its own.
  targetMarginPercent Decimal? @map("target_margin_percent") @db.Decimal(7, 4)

  currency String @default("USD")

  // ── Hardware spec (derived from components when present, hand-entered otherwise) ──
  gpuModel    String @default("") @map("gpu_model")
  gpuCount    Int    @default(0) @map("gpu_count")
  vramGb      Float  @default(0) @map("vram_gb")
  vcpu        Float  @default(0)
  ramGb       Float  @default(0) @map("ram_gb")
  storageGb   Float  @default(0) @map("storage_gb")
  storageType String @default("") @map("storage_type")
  networkGbps Float  @default(0) @map("network_gbps")

  regions String[] @default(["default"])

  capacityTotal     Int @default(0) @map("capacity_total")
  capacityAllocated Int @default(0) @map("capacity_allocated")

  status TierStatus @default(available)

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  metadata Json?

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("TierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("TierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supportedByModels               AIModelSupportedTier[] @relation("AIModelSupportedTierTier")
  deployments                     Deployment[]           @relation("DeploymentTier")
  deploymentSizingRecommendations Deployment[]           @relation("DeploymentSizingRecommendedTier")
  capacityEvents                  TierCapacityEvent[]    @relation("TierCapacityEventTier")
  prices                          TierPrice[]            @relation("TierPriceTier")

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@index([categoryId])
  @@map("tiers")
}

/**
 * What a machine type's stock was, and when.
 * `Tier.capacityTotal`, `capacityAllocated` and `status` are mutated in place,
 * so "was the A100 out of stock last Tuesday" is not a question the tiers
 * table can answer — the old value is simply gone. Without this row nobody can
 * ever say how long an outage lasted, which is the one number that turns
 * "we were out of stock" into "we were out of stock for nine hours and turned
 * away six deployments".
 * Append-only, and ONE table rather than two. A change event log plus a daily
 * snapshot table would have been the obvious shape, but a single log with a
 * daily heartbeat row gives both: consecutive rows under a window function
 * (`lead(at) OVER (PARTITION BY tier_id ORDER BY at)`) yield exact outage
 * durations, and filtering `is_heartbeat` yields the daily series.
 * Written inside the same transaction as the capacity mutation itself — a log
 * written after the fact drifts from reality under concurrency, and every
 * duration computed from it afterwards is quietly wrong.
 */
model TierCapacityEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tierId String @map("tier_id") @db.Uuid
  tier   Tier   @relation("TierCapacityEventTier", fields: [tierId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  capacityTotal     Int        @map("capacity_total")
  capacityAllocated Int        @map("capacity_allocated")
  available         Int
  status            TierStatus

  // Snapshotted because the list price moves, and "what did an hour of this
  // cost while it was unavailable" is unanswerable later otherwise.
  pricePerHour Decimal @default(0) @map("price_per_hour") @db.Decimal(12, 4)

  activeDeployments Int @default(0) @map("active_deployments")

  // 'deployment_started' | 'deployment_ended' | 'admin_edit' | 'heartbeat'
  reason      String  @default("")
  isHeartbeat Boolean @default(false) @map("is_heartbeat")

  @@index([tierId, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@index([status, at(sort: Desc)])
  @@map("tier_capacity_events")
}

/**
 * What one tier costs us, and what it sells for, on ONE cloud in ONE region.
 *
 * ── Why a tier cannot have a single price any more ──
 *
 * `Tier.pricePerHour` is one number. That was right when there was one cloud
 * and one region. It is wrong now: the same machine costs a different amount
 * on Google than on AWS, and a different amount in Mumbai than in Ireland. One
 * price across all of them means that in some cell we are either uncompetitive
 * or — the one that matters — selling below cost.
 *
 * So a tier's price is a small table rather than a number: one row per
 * (tier × cloud × region). Six rows for two clouds and three regions.
 *
 * ── Which half is computed, and which is chosen ──
 *
 * Everything down to `floorPricePerHour` is COST, recomputed hourly by
 * `jobs/tierPriceRefresh.js` from the cloud's own live rates. Nobody types it.
 *
 * `sellPricePerHour` is the only number that is chosen — and normally it is
 * not typed either: the refresh sets it to this row's own floor, so one margin
 * decision prices the whole table. An admin who overrides a single cell sets
 * `sellPriceIsOverridden`, and the job then leaves that cell alone; without
 * the flag the next hourly pass would silently undo their edit.
 *
 * ── Why cost is stored rather than computed on demand ──
 *
 * A customer opening the deploy screen must not set off a fan-out of provider
 * price calls, and a provider outage must not make the catalogue unsellable.
 * The stored figure is what is shown and what is charged; `capGuard` re-checks
 * against live cost before building, as the backstop.
 */
model TierPrice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tierId String @map("tier_id") @db.Uuid
  tier   Tier   @relation("TierPriceTier", fields: [tierId], references: [id], onDelete: Cascade)

  /// 'gcp' | 'aws' — the names cloudRouter uses.
  cloud String

  /// The PLATFORM region ("eu-central"), not the cloud's own ("eu-west-1").
  /// The platform name is what a tier and a deployment carry; the provider's
  /// name is an implementation detail of whichever cloud serves it.
  region String

  /// What this tier actually builds as here, recorded so an admin can see that
  /// "2 vCPU / 8 GB" became `m6i.large` on one cloud and `e2-standard-2` on the
  /// other.
  machineType String @default("") @map("machine_type")

  // ── Cost. Refreshed hourly, never typed. ──

  /// The machine and its disk, as the provider charges for them.
  providerCostPerHour Decimal @default(0) @map("provider_cost_per_hour") @db.Decimal(12, 6)

  /// This machine's share of what the REGION costs before any machine runs in
  /// it — chiefly NAT. On AWS that is a flat per-gateway charge that exists at
  /// zero machines; on Google it scales per VM and is nearly nothing. See
  /// `CloudRegionCost`, which holds the figure this share is divided out of.
  regionalSharePerHour Decimal @default(0) @map("regional_share_per_hour") @db.Decimal(12, 6)

  overheadPerHour  Decimal @default(0) @map("overhead_per_hour") @db.Decimal(12, 6)
  taxPerHour       Decimal @default(0) @map("tax_per_hour") @db.Decimal(12, 6)
  totalCostPerHour Decimal @default(0) @map("total_cost_per_hour") @db.Decimal(12, 6)

  /// `totalCostPerHour` × (1 + margin). Nothing may be sold below this.
  floorPricePerHour Decimal @default(0) @map("floor_price_per_hour") @db.Decimal(12, 6)

  /// 'live' | 'recorded' | 'unknown' — where the provider figure came from.
  costSource String    @default("unknown") @map("cost_source")
  costAsOf   DateTime? @map("cost_as_of")

  // ── Sell ──

  sellPricePerHour    Decimal @default(0) @map("sell_price_per_hour") @db.Decimal(12, 4)
  stoppedPricePerHour Decimal @default(0) @map("stopped_price_per_hour") @db.Decimal(12, 4)

  /// An admin typed this cell's price. The hourly refresh must not overwrite it.
  sellPriceIsOverridden Boolean @default(false) @map("sell_price_is_overridden")

  /// 'sellable' | 'below_floor' | 'unpriced' | 'unbuildable'
  /// Only `sellable` may be offered to a customer. `unbuildable` means this
  /// cloud has no shape for these specs at all — a single A100 on AWS, where
  /// they are sold only in eights.
  status String @default("unpriced")

  lastError String @default("") @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tierId, cloud, region], map: "tier_prices_identity_key")
  // The customer's question: "which regions can I have this tier in, on the
  // cloud my model runs on, right now?"
  @@index([cloud, region, status])
  @@index([tierId, status])
  @@map("tier_prices")
}

/**
 * What a REGION costs before a single customer machine runs in it.
 *
 * ── The cost with no customer attached to it ──
 *
 * Opening a region is not free. A NAT gateway on AWS is about $0.045 an hour
 * per availability zone and is charged whether zero machines use it or a
 * hundred — roughly $65 a month, per region, standing. Google's Cloud NAT
 * charges per VM instead, so the same region costs almost nothing until it is
 * used.
 *
 * That difference is the whole reason this table exists. Without it the first
 * customer in a fresh AWS region is served at a loss that nothing in the
 * system can see.
 *
 * ── How it reaches a price ──
 *
 * `regionalSharePerHour = fixedCostPerHour / max(assumedMachines, 1)`, added
 * into every `TierPrice` row for that cloud and region.
 *
 * `assumedMachines` is a judgement, not a measurement: how many machines the
 * operator expects to spread the standing cost across. It defaults to 1, which
 * is the only setting that cannot lose money — and which also prices a new
 * region high enough that it may never fill. `liveMachines` records what is
 * actually running, so the gap between the two is visible rather than guessed
 * at, and the admin screen states the break-even count outright.
 */
model CloudRegionCost {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  cloud  String
  region String

  /// The standing cost of having this region open at all, read live from the
  /// provider where it publishes it. On AWS this is the NAT gateways, charged
  /// per availability zone whether anything uses them or not.
  fixedCostPerHour Decimal @default(0) @map("fixed_cost_per_hour") @db.Decimal(12, 6)

  /// The part of the regional cost that DOES scale with machines, charged once
  /// per machine rather than spread.
  ///
  /// Kept apart from `fixedCostPerHour` because the two clouds put their NAT
  /// charge in different places: AWS bills a gateway whether or not anything
  /// uses it, while Google bills per VM attached to the NAT. Folding Google's
  /// per-VM charge into the fixed figure would make it correct only at the
  /// exact moment `liveMachines` happened to equal `assumedMachines`, and
  /// wrong — in whichever direction loses money — the rest of the time.
  perMachineCostPerHour Decimal @default(0) @map("per_machine_cost_per_hour") @db.Decimal(12, 6)

  /// 'live' | 'recorded' | 'unknown'
  costSource String    @default("unknown") @map("cost_source")
  costAsOf   DateTime? @map("cost_as_of")

  /// How many machines to spread the standing cost across. A judgement.
  /// 1 is the only value that cannot lose money.
  assumedMachines Int @default(1) @map("assumed_machines")

  /// How many are actually running here, counted by the refresh. Reporting
  /// only, never an input to a price — a price that moved with live occupancy
  /// would charge two customers differently for the same hour.
  liveMachines Int @default(0) @map("live_machines")

  /// ── Whether this region's network has actually been built ──
  ///
  /// Separate from whether it is COSTED, and that separation is the point. The
  /// platform costs and sells a region before building it, so the region's
  /// standing cost is inside every price from the start and the first customer
  /// there is not subsidised. What is missing on day one is the network, not
  /// the price.
  ///
  /// 'unbuilt'  — sold and costed, nothing applied there yet
  /// 'wanted'   — an order is waiting on it; someone should build it
  /// 'building' — an apply is running
  /// 'built'    — the ids are in settings and launches work
  /// 'failed'   — an apply was tried and did not finish
  buildState String @default("unbuilt") @map("build_state")

  /// How many orders are waiting on this region right now. Drives the admin's
  /// work list: a region with orders on it is urgent, one without is a plan.
  waitingDeployments Int @default(0) @map("waiting_deployments")

  /// When a build was last asked for, started and finished — so an apply that
  /// died halfway can be told from one that was never started.
  buildWantedAt   DateTime? @map("build_wanted_at")
  buildStartedAt  DateTime? @map("build_started_at")
  buildFinishedAt DateTime? @map("build_finished_at")

  /// Why the last build failed, for the admin. Never shown to a customer — it
  /// names our own infrastructure.
  buildError String @default("") @map("build_error")

  /// When the region build worker last said it was alive.
  ///
  /// The worker is a separate process, under a different OS user, holding a
  /// credential the API deliberately cannot read. So the API cannot inspect
  /// it — being able to would be the access this design exists to avoid — and
  /// a heartbeat is the only honest way to know whether asking for a region
  /// will actually build one, or merely leave a note for a human.
  workerSeenAt DateTime? @map("worker_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cloud, region], map: "cloud_region_costs_identity_key")
  @@map("cloud_region_costs")
}

// One line of a tier's bill of materials. `{ _id: false }` in the source —
// a child row of its parent, with no identity of its own.
model TierComponent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tierId String @map("tier_id") @db.Uuid
  tier   Tier   @relation("TierComponents", fields: [tierId], references: [id], onDelete: Cascade)
  order  Int    @default(0)

  componentId String            @map("component_id") @db.Uuid
  component   ResourceComponent @relation("TierComponentResourceComponent", fields: [componentId], references: [id], onDelete: Restrict)

  // Snapshotted from ResourceComponent when the line was last resolved
  kind      String @default("other")
  name      String @default("")
  slug      String @default("")
  unitLabel String @default("unit") @map("unit_label")

  quantity           Decimal @db.Decimal(12, 4)
  unitPricePerHour   Decimal @default(0) @map("unit_price_per_hour") @db.Decimal(12, 6)
  billedWhileStopped Boolean @default(false) @map("billed_while_stopped")
  lineTotalPerHour   Decimal @default(0) @map("line_total_per_hour") @db.Decimal(12, 6)

  specs Json?

  @@index([tierId, order])
  @@index([componentId])
  @@map("tier_components")
}

model AIModel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name String  @unique
  slug String? @unique

  family  ModelFamily @default(custom)
  version String      @default("")

  shortDescription String @default("") @map("short_description")
  description      String @default("")

  logoUrl       String @default("") @map("logo_url")
  docsUrl       String @default("") @map("docs_url")
  huggingFaceId String @default("") @map("hugging_face_id")
  license       String @default("")

  modalities Modality[] @default([chat])

  parameterSize String @default("") @map("parameter_size")
  contextLength Int    @default(0) @map("context_length")

  /**
   * What this model needs to run at all.
   *
   * ── Why these are on the MODEL and not only in the answers ──
   *
   * Until now a model declared one number, `minVramGb`, and everything else a
   * machine had to provide — cards, cores, memory — was inferred from what the
   * customer said about their workload. That works for "how busy will it be"
   * and not at all for "will it start": a model needing two cards does not
   * need them because of anyone's traffic, it needs them because the weights
   * do not fit on one.
   *
   * Sizing takes the stricter of the two, so an answer that implies more still
   * wins. These are the floor beneath that.
   *
   * Zero means "not stated", which is why they default to 0 rather than to a
   * guess: a model nobody has filled in must not start refusing machines that
   * used to run it.
   */
  minVramGb   Float @default(0) @map("min_vram_gb")
  minGpuCount Int   @default(0) @map("min_gpu_count")
  minVcpu     Float @default(0) @map("min_vcpu")
  minRamGb    Float @default(0) @map("min_ram_gb")

  supportedTiers AIModelSupportedTier[] @relation("AIModelSupportedTiers")
  useCases       AIModelUseCase[]       @relation("AIModelUseCases")

  strengths   String[] @default([])
  limitations String[] @default([])

  status AIModelStatus @default(available)

  category String   @default("General")
  tags     String[] @default([])

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  isFeatured   Boolean @default(false) @map("is_featured")

  /// Which cloud this model's deployments are built on. Null means "use the
  /// platform default", which is what every model starts as.
  ///
  /// This is the per-model assignment: Kimi K3 and Llama on AWS, DeepSeek on
  /// Google, say. It only decides where the NEXT deployment goes — changing it
  /// never moves a machine that already exists, because the cloud is frozen
  /// onto each deployment at creation (see Deployment.cloudProvider).
  ///
  /// A model pinned to a cloud that is switched off does NOT fall back to the
  /// other one. It goes to the manual queue instead: the pin was a deliberate
  /// choice, and the other cloud may not have a tier that can build it.
  cloudProvider String? @map("cloud_provider")

  metadata Json?

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("AIModelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("AIModelUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deployments Deployment[] @relation("DeploymentModel")

  @@index([slug])
  @@index([isActive])
  @@index([status])
  @@index([family])
  @@index([displayOrder])
  @@map("ai_models")
}

// Which tiers a model can run on, and what it costs on each.
// A child row of its parent, with no identity of its own.
model AIModelSupportedTier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  aiModelId String  @map("ai_model_id") @db.Uuid
  aiModel   AIModel @relation("AIModelSupportedTiers", fields: [aiModelId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  tierId String @map("tier_id") @db.Uuid
  tier   Tier   @relation("AIModelSupportedTierTier", fields: [tierId], references: [id], onDelete: Restrict)

  tierName        String  @default("") @map("tier_name")
  recommended     Boolean @default(false)
  priceMultiplier Decimal @default(1) @map("price_multiplier") @db.Decimal(6, 4)
  notes           String  @default("")

  @@index([aiModelId, order])
  @@index([tierId])
  @@map("ai_model_supported_tiers")
}

// What a model is good at, ticked from the shared UseCaseTag vocabulary.
// `key` is a soft reference to UseCaseTag.key (never a real FK — same
// vocabulary QuestionTemplate signals draw from). `{ _id: false }` in the
// A child row of its parent, with no identity of its own.
model AIModelUseCase {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  aiModelId String  @map("ai_model_id") @db.Uuid
  aiModel   AIModel @relation("AIModelUseCases", fields: [aiModelId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  key   String
  label String          @default("")
  fit   ModelUseCaseFit @default(good)
  note  String          @default("")

  @@index([aiModelId, order])
  @@map("ai_model_use_cases")
}

// ============================================================================
// ==== Billing / Payment domain ====
// ============================================================================

// ============================================================================
// ==== Teams ====
// ============================================================================

/**
 * The account that owns money and resources: wallet, ledger, cards, payments,
 * deployments and usage all hang off a Team, never directly off a User.
 * `personal` — the individual account every customer gets at signup. One per
 * user (partial unique index in the migration), always exactly one member,
 * and shown to the customer simply as "Personal". An individual who never
 * creates or joins a team only ever sees this, and the product looks exactly
 * as it did before teams existed.
 * `team` — an organization with members and roles (TeamMember).
 * One model for both so there is one billing system, not two: every billing
 * service takes a team id and does not care which kind it is.
 */
model Team {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  kind TeamKind @default(team)
  name String

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Pay-as-you-go access for this account: 'default' follows the platform
  // switch, 'allowed' / 'blocked' override it. Only the door — every PAYG rule
  // still applies (fundingService.resolvePaygAccess). DB CHECK in migration.
  paygAccess String @default("default") @map("payg_access")

  /// Can this account's deployments be built automatically on the cloud?
  ///
  /// **Default true, deliberately.** Every customer gets automatic
  /// provisioning; an admin turns it OFF for one account when they want to
  /// look at that account's requests first. An opt-in allowlist was the
  /// earlier design and it was wrong for this product: it made the normal
  /// case the one that needed work, and quietly left every new customer on
  /// the manual queue forever.
  ///
  /// Off does not mean refused — it means reviewed. Those deployments wait in
  /// `pending_review`, and an admin approving one provisions it on the cloud
  /// exactly as the automatic path would have.
  ///
  /// This lives on Team rather than User because deployments, wallets and
  /// cards are all account-scoped, and a personal account is a Team of
  /// `kind: personal` — so one column covers both without the "organizations
  /// only" blind spot that the pay-as-you-go toggle has.
  autoDeploy          Boolean   @default(true) @map("auto_deploy")
  autoDeployOffReason String    @default("") @map("auto_deploy_off_reason")
  autoDeployChangedAt DateTime? @map("auto_deploy_changed_at")

  // A chargeback on this account's card — a fraud/trust hold.
  disputeHold   Boolean   @default(false) @map("dispute_hold")
  disputeReason String    @default("") @map("dispute_reason")
  disputedAt    DateTime? @map("disputed_at")

  // The gateway customer this account's saved cards belong to.
  stripeCustomerId String? @map("stripe_customer_id")
  polarCustomerId  String? @map("polar_customer_id")

  /**
   * The company domain this team has proved it controls, and what happens when
   * somebody with an email at that domain turns up.
   * Proof is a DNS TXT record holding `domainToken` — an address at the domain
   * is not proof, because anyone can be given a mailbox somewhere. Until
   * `domainVerifiedAt` is set the claim counts for nothing. One verified domain
   * belongs to one team (partial unique index in the migration), so two teams
   * cannot both claim to be acme.com.
   * `domainJoinMode`: off (default), request (they ask, an owner or admin
   * decides) or auto (they are in as soon as they verify their email).
   * `domainJoinRole` is what they come in as, and may only be a role that sees
   * no money — nobody reaches a team's wallet by signing up with an address.
   */
  /**
   * /**
   * /**
   * "Somebody at your company is already here."
   * Off for every team until its owner turns it on. Whether an email domain
   * is a public mailbox provider is not a question any list can answer for
   * the whole internet, so nothing about a team is ever disclosed because a
   * domain looked private — it is disclosed because the owner chose to be
   * findable by colleagues at their own address. The blocklists and the
   * popularity check sit on top of that consent, never in place of it.
   */
  discoverableByDomain Boolean @default(false) @map("discoverable_by_domain")

  verifiedDomain   String?   @map("verified_domain")
  domainToken      String?   @map("domain_token")
  domainVerifiedAt DateTime? @map("domain_verified_at")
  domainJoinMode   String    @default("off") @map("domain_join_mode")
  domainJoinRole   TeamRole  @default(developer) @map("domain_join_role")

  // Soft delete only — the ledger of an account that ever held money is kept.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            TeamMember[]        @relation("TeamMemberTeam")
  invitations        TeamInvitation[]    @relation("TeamInvitationTeam")
  activity           TeamActivity[]      @relation("TeamActivityTeam")
  ownershipTransfers OwnershipTransfer[] @relation("OwnershipTransferTeam")
  joinRequests       TeamJoinRequest[]   @relation("TeamJoinRequestTeam")
  joinLinks          TeamJoinLink[]      @relation("TeamJoinLinkTeam")
  seatCharges        TeamSeatCharge[]    @relation("TeamSeatChargeTeam")
  churnSnapshots     ChurnRiskSnapshot[] @relation("ChurnRiskSnapshotTeam")
  wallet             CreditWallet?       @relation("CreditWalletTeam")
  creditTransactions CreditTransaction[] @relation("CreditTransactionTeam")
  paymentMethods     PaymentMethod[]     @relation("PaymentMethodTeam")
  payments           Payment[]           @relation("PaymentTeam")
  deployments        Deployment[]        @relation("DeploymentTeam")
  deploymentUsages   DeploymentUsage[]   @relation("DeploymentUsageTeam")

  @@index([createdById])
  @@index([deletedAt], map: "teams_deleted_at_idx")
  @@index([kind, createdAt(sort: Desc)], map: "teams_kind_created_at_idx")
  @@map("teams")
}

model TeamMember {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("TeamMemberTeam", fields: [teamId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  role TeamRole @default(developer)

  // Monthly spend ceiling for this member in the platform currency. Null = no
  // limit. Enforced in fundingService for the roles it applies to.
  spendLimitMonthly Decimal? @map("spend_limit_monthly") @db.Decimal(12, 4)

  // The highest spend-limit alert already sent to the team's owner/admins this
  // month (80 or 100), and which month that was ("YYYY-MM", UTC) — so each
  // threshold notifies once per month, not on every hourly run.
  limitAlertLevel Int     @default(0) @map("limit_alert_level")
  limitAlertMonth String? @map("limit_alert_month")

  invitedById String? @map("invited_by_id") @db.Uuid
  invitedBy   User?   @relation("TeamMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  joinedAt  DateTime @default(now()) @map("joined_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  @@index([userId])
  @@index([userId, joinedAt(sort: Desc)], map: "team_members_user_id_joined_at_idx")
  @@map("team_members")
}

/**
 * An invitation to join a team by email. The link's token is never stored —
 * only its SHA-256 — so a leaked database cannot be used to join anything.
 * Single-use (acceptedAt), revocable, expiring, and bound to the invited
 * email: only a verified account with that exact address can accept it.
 */
model TeamInvitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("TeamInvitationTeam", fields: [teamId], references: [id], onDelete: Cascade)

  email String // lower-cased
  role  TeamRole

  tokenHash String @unique @map("token_hash")

  invitedById String? @map("invited_by_id") @db.Uuid
  invitedBy   User?   @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  declinedAt DateTime? @map("declined_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([email])
  // The invitation funnel is asked platform-wide, so the team-leading index
  // above cannot serve it.
  @@index([createdAt(sort: Desc)], map: "team_invitations_created_at_idx")
  @@map("team_invitations")
}

/**
 * What happened inside a team, in the team's own words: who invited whom, who
 * changed a role or a spend limit, who left, who handed over the team. Read by
 * the team's Owner/Admin in the customer center. The admin audit trail
 * (`ActivityLog`) is a separate, admin-facing table and the two never mix —
 * one customer must never be able to read the platform's own log.
 * The actor's name and email are copied onto the row. Someone who has since
 * been removed from the team, or deleted their account, must still read as the
 * person who did it: a history that decays into "someone" is not a history.
 * `action` is a stable key, never a sentence, and `metadata` carries the names
 * and values it needs — so the customer center renders every entry in the
 * reader's own language, for the same reason notifications store a
 * `contentKey` instead of prose.
 */
model TeamActivity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("TeamActivityTeam", fields: [teamId], references: [id], onDelete: Cascade)

  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation("TeamActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String  @map("actor_name")
  actorEmail  String  @map("actor_email")

  action String

  // Polymorphic, like ActivityLog.targetId: a plain id, because the thing it
  // points at may since have been removed and the entry is still worth having.
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  targetName String? @map("target_name")

  metadata Json @default("{}")

  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([teamId, createdAt(sort: Desc)])
  // Member arrivals and departures, counted across every organization.
  @@index([action, createdAt(sort: Desc)], map: "team_activity_action_created_at_idx")
  @@map("team_activity")
}

/**
 * A pending handover of a team to one of its existing members. Ownership never
 * moves on one person's say-so: the owner offers, the member accepts, and only
 * then do the two roles swap — the old owner stays on as an admin rather than
 * being dropped out of their own team.
 * None of the money moves with it. The wallet, the cards and any outstanding
 * balance belong to the team, so a transfer can never be used to hand a debt
 * to someone else or to walk away from one.
 * At most one offer is open per team at a time (partial unique index in the
 * migration), and an offer expires if it is left unanswered.
 */
model OwnershipTransfer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("OwnershipTransferTeam", fields: [teamId], references: [id], onDelete: Cascade)

  fromUserId String @map("from_user_id") @db.Uuid
  fromUser   User   @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String @map("to_user_id") @db.Uuid
  toUser   User   @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  declinedAt  DateTime? @map("declined_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([toUserId])
  @@map("ownership_transfers")
}

/**
 * Someone with an email at a team's verified domain asking to be let in, for a
 * team whose `domainJoinMode` is `request`. An owner or admin answers it.
 * A colleague turning up is not the same as a colleague being trusted, which
 * is why `request` is the mode a team is nudged towards: `auto` lets in
 * everyone the domain's mail admin ever creates an address for.
 * One open request per person per team (partial unique index in the
 * migration), so asking twice cannot fill anyone's screen.
 */
model TeamJoinRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("TeamJoinRequestTeam", fields: [teamId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("TeamJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  // The address it was asked from, kept as written: the request is only valid
  // while it still matches the team's verified domain.
  email String

  // The link it came through, or null when it came from the company-domain
  // hint. Either way an owner or admin still has to say yes.
  joinLinkId String?       @map("join_link_id") @db.Uuid
  joinLink   TeamJoinLink? @relation("TeamJoinLinkRequests", fields: [joinLinkId], references: [id], onDelete: SetNull)

  decidedById String? @map("decided_by_id") @db.Uuid
  decidedBy   User?   @relation("TeamJoinRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  approvedAt  DateTime? @map("approved_at")
  declinedAt  DateTime? @map("declined_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([createdAt(sort: Desc)], map: "team_join_requests_created_at_idx")
  @@map("team_join_requests")
}

/**
 * One link a team can hand round its own chat: whoever opens it can ask to
 * join, and an owner or admin decides. Asking, not entering, is the whole
 * point — a link that is forwarded, screenshotted or left in an ex-employee's
 * inbox gets somebody a refusal, not an account that spends money.
 * Only the SHA-256 of the token is stored, as with invitations, so a copy of
 * the database cannot be used to join anything. A link expires, can be revoked
 * and can carry a cap on how many people come through it; re-issuing one
 * revokes the last (partial unique index in the migration), because a second
 * forgotten door is exactly what this must not become.
 * `role` is limited to Developer or Viewer by a database CHECK: opening a link
 * must never be a way to reach a team's money.
 */
/**
 * One day of a team's seat fee, and the proof it was charged.
 * The fee is billed a day at a time so that joining mid-month costs from that
 * day and leaving stops costing the same afternoon. The unique (team, day)
 * index is what makes a second run of the job — a retry, a restart, an admin
 * pressing it again — harmless: the day is already settled, so nothing happens.
 * The row keeps what cannot be worked out later: how many seats there were,
 * how many the platform gave away, and the monthly fee in force that day.
 * `toWallet` and `toDebt` record what the wallet could cover and what became
 * debt — an unpaid seat fee is owed, never forgiven.
 */
model TeamSeatCharge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("TeamSeatChargeTeam", fields: [teamId], references: [id], onDelete: Cascade)

  day DateTime @db.Date

  seats      Int     @map("seats")
  freeSeats  Int     @map("free_seats")
  monthlyFee Decimal @map("monthly_fee") @db.Decimal(12, 4)

  amount   Decimal @db.Decimal(12, 4)
  toWallet Decimal @default(0) @map("to_wallet") @db.Decimal(12, 4)
  toDebt   Decimal @default(0) @map("to_debt") @db.Decimal(12, 4)
  currency String  @default("USD")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, day])
  @@index([day(sort: Desc)])
  @@map("team_seat_charges")
}

model TeamJoinLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("TeamJoinLinkTeam", fields: [teamId], references: [id], onDelete: Cascade)

  tokenHash String @unique @map("token_hash")

  role TeamRole @default(developer)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("TeamJoinLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  expiresAt DateTime  @map("expires_at")
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  requests TeamJoinRequest[] @relation("TeamJoinLinkRequests")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)], map: "team_join_links_created_at_idx")
  @@map("team_join_links")
}

/**
 * One account's churn risk, as it looked on one day.
 * ── Why this cannot be computed later ──
 * A churn score is built from the state of things RIGHT NOW: how many days
 * since anyone signed in, what the wallet holds today, how many automatic
 * charges have failed so far. None of that is recoverable for a past date —
 * `credit_wallets.balance` is overwritten, `users.last_login` keeps only the
 * most recent one. So "is our at-risk list getting shorter?", which is the
 * only question that tells an operator whether anything they did worked, is
 * unanswerable forever unless the score is written down as it is computed.
 * `reasons` carries the rendered sentences and the figures behind them, not
 * just the signal keys. An operator reading last month's snapshot must see the
 * same explanation the list showed that day, even after the templates have
 * been reworded or a weight retuned — a history that silently re-renders under
 * today's policy is not a history of what was decided.
 * Only accounts at or above `churn.snapshotMinScore` are written. The healthy
 * majority would otherwise be one row per team per day, forever, answering a
 * question nobody asks.
 */
model ChurnRiskSnapshot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("ChurnRiskSnapshotTeam", fields: [teamId], references: [id], onDelete: Cascade)

  day DateTime @db.Date

  score Int
  band  String

  // Copied onto the row: an account that has since been renamed or closed must
  // still read as what it was on the day it was flagged.
  teamName String @map("team_name")
  teamKind String @map("team_kind")

  /**
   * `[{ key, weight, sentence, values }]` — what fired, how much it counted,
   * and the sentence shown for it. `signals` keeps the raw measurements so a
   * later policy can be re-scored against the same evidence if anyone wants to
   * ask what a different weighting would have said.
   */
  reasons Json @default("[]")
  signals Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, day])
  @@index([day(sort: Desc), score(sort: Desc)])
  @@index([band, day(sort: Desc)])
  @@map("churn_risk_snapshots")
}

/**
 * One page view, as recorded by the platform's own collector.
 * ── Why the platform has a collector at all ──
 * `ActivityLog.userId` is a required, non-null foreign key, so it physically
 * cannot record somebody who has not signed in — and the people worth
 * measuring on a marketing site are exactly the ones who have not. Nothing
 * else on the platform stores a URL or a visit. This table is the first.
 * ── Who a "visitor" is, and why there is no cookie ──
 * `visitorHash` is `sha256(daily salt + anonymised IP + user agent)`. It is
 * recomputed from a salt that rotates every day, so the same person on two
 * days produces two unrelated hashes and nothing here can follow anyone over
 * time. Nothing is stored on the visitor's device: no cookie, no
 * localStorage, no consent banner to need. The cost is that "returning
 * visitor" is not a question this data can answer, which is the right trade.
 * ── This table is the short-term one ──
 * It is pruned at `AdminSettings.analyticsSettings.dataRetentionDays`. The
 * long-term history lives in the rollups, which is why those exist at all: a
 * year-on-year comparison must survive a ninety-day retention.
 */
model PageViewEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // 'marketing' | 'customer' | 'admin' — which surface reported it. Each can
  // be switched off independently in the admin settings.
  site String

  sessionId String         @map("session_id") @db.Uuid
  session   TrafficSession @relation("TrafficSessionViews", fields: [sessionId], references: [id], onDelete: Cascade)

  // The URL as stored: query keys on the operator's strip list are removed
  // SERVER-SIDE before this is written. The customer center's own links carry
  // invitation and reset tokens, and a page-view table is the one place a
  // leaked URL would sit forever.
  path        String
  // `path` collapsed through the policy's pattern rules — '/blog/:slug'. What
  // every report groups by; the raw path is kept for looking one up.
  pathPattern String @map("path_pattern")

  // Host only, never the full referring URL: the path of the page somebody
  // came from is their business, and the host is all a source report needs.
  referrerHost String @default("") @map("referrer_host")

  // Derived once, at write time, so reports never re-parse a user agent.
  source   String @default("") // 'google', 'direct', a campaign name
  medium   String @default("") // 'organic' | 'referral' | 'direct' | 'cpc' …
  campaign String @default("")

  deviceType String @default("") @map("device_type") // desktop | mobile | tablet
  browser    String @default("")
  os         String @default("")

  // Milliseconds the visitor spent on the page, reported by the beacon when
  // they leave. Null where the browser never got to send it — a tab closed
  // mid-read is a real and common outcome, and it must not read as zero.
  durationMs Int? @map("duration_ms")

  at DateTime @default(now())

  @@index([at(sort: Desc)])
  @@index([site, at(sort: Desc)])
  @@index([sessionId, at(sort: Asc)])
  @@index([pathPattern, at(sort: Desc)])
  @@map("page_view_events")
}

/**
 * A visit: one person, one sitting.
 * Stitched server-side by `visitorHash` plus an idle gap from the policy —
 * not by anything the browser keeps. A session that has seen no beacon for
 * longer than the gap is closed by the nightly job and never reopened.
 * `bounced` is computed when the session closes rather than at read time,
 * because the definition involves a duration the last page view may never
 * have reported.
 */
model TrafficSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  site        String
  visitorHash String @map("visitor_hash")

  // The first page and the first referrer win. A session's source is where
  // the person came from, which is a fact about its beginning — re-attributing
  // it to a later internal link is how referral traffic turns into "direct".
  entryPath    String @map("entry_path")
  referrerHost String @default("") @map("referrer_host")
  source       String @default("")
  medium       String @default("")
  campaign     String @default("")

  deviceType String @default("") @map("device_type")
  browser    String @default("")
  os         String @default("")

  views      Int       @default(0)
  startedAt  DateTime  @default(now()) @map("started_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  endedAt    DateTime? @map("ended_at")

  // Set when the session is closed. Null means "still open, not yet judged".
  bounced     Boolean?
  durationSec Int?     @map("duration_sec")

  pageViews PageViewEvent[] @relation("TrafficSessionViews")

  @@index([visitorHash, lastSeenAt(sort: Desc)])
  @@index([site, startedAt(sort: Desc)])
  @@index([endedAt, lastSeenAt])
  @@map("traffic_sessions")
}

/**
 * The daily rollup that outlives the raw events.
 * One row per day, site, dimension and value — `dimension = 'total'` carries
 * the headline series, and `'source'`, `'device'`, `'country'` and so on carry
 * the breakdowns. A key/value shape rather than a column per breakdown
 * deliberately: adding a dimension later is then a change to the rollup job,
 * not a migration, and the read path does not grow a branch per column.
 */
model TrafficDailyRollup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  day  DateTime @db.Date
  site String

  dimension String
  value     String

  views        Int @default(0)
  sessions     Int @default(0)
  visitors     Int @default(0)
  bounces      Int @default(0)
  // Summed, not averaged, so rows can be added together across days without
  // an average of averages — which is wrong whenever the days differ in size.
  totalSeconds Int @default(0) @map("total_seconds")

  @@unique([day, site, dimension, value])
  @@index([day(sort: Desc), dimension])
  @@map("traffic_daily_rollups")
}

/**
 * Per-page daily totals, kept separately because a path set is far larger
 * than any other dimension and would dominate the rollup table.
 */
model TrafficPathDaily {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  day         DateTime @db.Date
  site        String
  pathPattern String   @map("path_pattern")

  views        Int @default(0)
  sessions     Int @default(0)
  entries      Int @default(0)
  exits        Int @default(0)
  totalSeconds Int @default(0) @map("total_seconds")

  @@unique([day, site, pathPattern])
  @@index([day(sort: Desc), views(sort: Desc)])
  @@map("traffic_path_daily")
}

model CreditWallet {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  teamId String @unique @map("team_id") @db.Uuid
  team   Team   @relation("CreditWalletTeam", fields: [teamId], references: [id])

  balance            Decimal @default(0) @db.Decimal(12, 4)
  // Unpaid pay-as-you-go balance the spendable `balance` couldn't cover.
  // Deliberately separate — `balance` never goes negative. See debtService.
  outstandingBalance Decimal @default(0) @map("outstanding_balance") @db.Decimal(12, 4)

  debtSince      DateTime? @map("debt_since")
  debtNotifiedAt DateTime? @map("debt_notified_at")

  lastAutoChargeAt    DateTime? @map("last_auto_charge_at")
  autoChargeFailures  Int       @default(0) @map("auto_charge_failures")
  lastAutoChargeError String    @default("") @map("last_auto_charge_error")

  currency String @default("USD")

  lifetimeTopUp Decimal @default(0) @map("lifetime_top_up") @db.Decimal(14, 4)
  lifetimeSpend Decimal @default(0) @map("lifetime_spend") @db.Decimal(14, 4)

  // autoTopUp{} flattened — small fixed-shape nested object
  autoTopUpEnabled   Boolean @default(false) @map("auto_top_up_enabled")
  autoTopUpThreshold Decimal @default(10) @map("auto_top_up_threshold") @db.Decimal(12, 4)
  autoTopUpAmount    Decimal @default(50) @map("auto_top_up_amount") @db.Decimal(12, 4)

  lowBalanceNotifiedAt DateTime? @map("low_balance_notified_at")
  suspendedAt          DateTime? @map("suspended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creditTransactions CreditTransaction[] @relation("CreditTransactionWallet")

  @@index([outstandingBalance(sort: Desc)], map: "credit_wallets_outstanding_balance_idx")
  @@index([balance], map: "credit_wallets_balance_idx")
  @@index([debtSince], map: "credit_wallets_debt_since_idx")
  @@index([autoChargeFailures], map: "credit_wallets_auto_charge_failures_idx")
  @@map("credit_wallets")
}

// The immutable ledger behind CreditWallet. Append-only — createdAt only, no
// updatedAt. `userId`/`walletId` are onDelete: Restrict — stricter than
// A deliberate integrity constraint so a
// ledger row can never lose its link.
model CreditTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The account the money moved in.
  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("CreditTransactionTeam", fields: [teamId], references: [id], onDelete: Restrict)

  // The member it was on behalf of, when there is one (who paid a top-up, who
  // created the deployment being charged). Null for account-level entries.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("CreditTransactionUser", fields: [userId], references: [id], onDelete: Restrict)

  walletId String       @map("wallet_id") @db.Uuid
  wallet   CreditWallet @relation("CreditTransactionWallet", fields: [walletId], references: [id], onDelete: Restrict)

  type CreditTransactionType

  // Signed: + credit, - debit. Always the change to wallet.balance — 0 for a
  // row that only affects the debt side.
  amount       Decimal @db.Decimal(12, 4)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 4)

  // Signed change to CreditWallet.outstandingBalance this row caused.
  debtDelta        Decimal @default(0) @map("debt_delta") @db.Decimal(12, 4)
  outstandingAfter Decimal @default(0) @map("outstanding_after") @db.Decimal(12, 4)

  currency String @default("USD")

  source CreditTransactionSource @default(system)

  // Polymorphic (Payment._id for top-ups, Deployment._id for hourly charges)
  // — kept as an (id, model_name) string pair, no DB constraint, matching
  // current behavior exactly.
  referenceId    String? @map("reference_id")
  referenceModel String? @map("reference_model")

  description String @default("")
  metadata    Json?

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("CreditTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  usageAsTransaction     DeploymentUsage[] @relation("DeploymentUsageTransaction")
  usageAsDebtTransaction DeploymentUsage[] @relation("DeploymentUsageDebtTransaction")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([walletId])
  @@index([type, createdAt(sort: Desc)])
  @@index([referenceId])
  @@index([source, createdAt(sort: Desc)], map: "credit_transactions_source_created_at_idx")
  @@index([teamId, type, createdAt(sort: Desc)], map: "credit_transactions_team_type_created_at_idx")
  @@map("credit_transactions")
}

model PaymentMethod {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The account the card pays for.
  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("PaymentMethodTeam", fields: [teamId], references: [id])

  // The member who added it.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("PaymentMethodUser", fields: [userId], references: [id])

  gateway PaymentMethodGateway @default(stripe)

  providerCustomerId      String @map("provider_customer_id")
  providerPaymentMethodId String @map("provider_payment_method_id")

  // Stripe's own card fingerprint — same card, same value, regardless of who
  // tokenized it. Used to dedupe abuse across accounts.
  fingerprint String @default("")

  brand    String @default("")
  last4    String @default("")
  expMonth Int?   @map("exp_month")
  expYear  Int?   @map("exp_year")

  isDefault Boolean @default(false) @map("is_default")

  status PaymentMethodStatus @default(active)

  verifiedAt DateTime  @default(now()) @map("verified_at")
  lastUsedAt DateTime? @map("last_used_at")

  // lastFailure{} flattened — small fixed-shape nested object
  lastFailureCode    String    @default("") @map("last_failure_code")
  lastFailureMessage String    @default("") @map("last_failure_message")
  lastFailureAt      DateTime? @map("last_failure_at")

  // Smallest "days until expiry" threshold already warned about (30, then
  // 14, then 7) — not just whether a warning was ever sent.
  lastExpiryWarningDays Int? @map("last_expiry_warning_days")

  // When the card was last proven to still work by actually putting a small
  // authorisation through it and releasing it again (billingSettings.cardGate
  // .verifyWithAuthHold). `verifiedAt` only records that the card was once
  // tokenized successfully; a card can be cancelled, frozen or emptied long
  // after that and still look perfectly valid here, which is how an account
  // could run up pay-as-you-go debt against a card that had not been usable
  // for months. This is the timestamp the funding gate ages out.
  lastLiveCheckAt DateTime? @map("last_live_check_at")

  removedAt DateTime? @map("removed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One Stripe PaymentMethod object should only ever be attached once.
  @@unique([providerCustomerId, providerPaymentMethodId])
  @@index([teamId, status])
  @@index([userId, status])
  @@index([fingerprint])
  @@index([status])
  @@map("payment_methods")
}

// Append-only — createdAt only, no updatedAt.
model Payment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The account the money was paid into.
  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("PaymentTeam", fields: [teamId], references: [id])

  // The member who paid.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("PaymentUser", fields: [userId], references: [id])

  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String? @unique @map("stripe_invoice_id")

  type PaymentType @default(topup)

  creditsAdded Decimal @default(0) @map("credits_added") @db.Decimal(12, 4)
  amount       Decimal @db.Decimal(12, 4)
  currency     String  @default("usd")

  status PaymentStatus @default(pending)

  description String?
  receiptUrl  String? @map("receipt_url")
  invoiceUrl  String? @map("invoice_url")

  metadata Json?

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([status, paidAt(sort: Desc)], map: "payments_status_paid_at_idx")
  @@map("payments")
}

// ============================================================================
// ==== Notification domain ====
// ============================================================================

// Append-only — createdAt only, no updatedAt. Expiry of
// `expiresAt` (auto-delete) has no Postgres equivalent; Phase 5 replaces it
// with a `notificationCleanup` cron job doing
// `prisma.notification.deleteMany({ where: { expiresAt: { lt: new Date() } } })`.
model Notification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  recipientId   String                    @map("recipient_id") @db.Uuid
  recipient     User                      @relation("NotificationRecipient", fields: [recipientId], references: [id])
  recipientType NotificationRecipientType @default(customer) @map("recipient_type")

  // Large, app-editable vocab (~20 values) — stays String, not an enum.
  type String

  // The English wording, frozen at write time. Still written for every
  // notification: it is what the admin history shows, and it is the whole
  // answer for any row that predates `contentKey`.
  title   String
  message String

  // Which piece of copy this is (e.g. 'deployment.ready'), so the bell can be
  // rendered in the reader's own language at read time instead of being stuck
  // in whatever language it happened to be written in. Its placeholders come
  // from `metadata`. Null on older rows, which fall back to `title`/`message`.
  contentKey String? @map("content_key")

  // action{} flattened — small fixed-shape nested object
  actionLabel String?
  actionUrl   String?

  priority NotificationPriority @default(medium)

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  senderId   String? @map("sender_id") @db.Uuid
  sender     User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName String  @default("System") @map("sender_name")

  metadata Json?

  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@index([recipientId, type])
  @@index([expiresAt])
  @@map("notifications")
}

// ============================================================================
// ==== Deployment domain ====
// ============================================================================

model Deployment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The account that owns and pays for this deployment.
  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("DeploymentTeam", fields: [teamId], references: [id])

  // The member who created it — not the owner: a deployment outlives its
  // creator leaving the team. Used for per-member spend limits.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("DeploymentUser", fields: [userId], references: [id])

  deploymentName String @map("deployment_name")

  // ── model{} snapshot (frozen at order time) + nullable convenience FK ──
  modelId            String?  @map("model_id") @db.Uuid
  model              AIModel? @relation("DeploymentModel", fields: [modelId], references: [id], onDelete: SetNull)
  modelName          String   @default("") @map("model_name")
  modelSlug          String   @default("") @map("model_slug")
  modelFamily        String   @default("") @map("model_family")
  modelVersion       String   @default("") @map("model_version")
  modelParameterSize String   @default("") @map("model_parameter_size")
  modelContextLength Int      @default(0) @map("model_context_length")

  // ── tier{} snapshot (frozen at order time) + nullable convenience FK ──
  tierId           String? @map("tier_id") @db.Uuid
  tier             Tier?   @relation("DeploymentTier", fields: [tierId], references: [id], onDelete: SetNull)
  tierName         String  @default("") @map("tier_name")
  tierCategoryName String  @default("") @map("tier_category_name")
  tierGpuModel     String  @default("") @map("tier_gpu_model")
  tierGpuCount     Int     @default(0) @map("tier_gpu_count")
  tierVramGb       Float   @default(0) @map("tier_vram_gb")
  tierVcpu         Float   @default(0) @map("tier_vcpu")
  tierRamGb        Float   @default(0) @map("tier_ram_gb")
  tierStorageGb    Float   @default(0) @map("tier_storage_gb")
  tierStorageType  String  @default("") @map("tier_storage_type")

  /**
   * Network bandwidth sold, in Gbps.
   * Part of the tier snapshot for the same reason every other figure here is:
   * the catalogue can be re-priced and re-specified, and what was sold must not
   * move with it. It was missing — `machineChoice` dropped it from the
   * normalised specs for catalogue tiers, so it survived only inside
   * `tierCustomBuild` for custom builds, and a catalogue deployment had no
   * record of it at all.
   * GCP does not let an instance ask for a bandwidth figure — it falls out of
   * the machine shape — so this is carried as "what was sold" for the admin to
   * judge against, not as something the provisioner can satisfy.
   */
  tierNetworkGbps Float @default(0) @map("tier_network_gbps")

  /// Which cloud this deployment's machine lives on. **Frozen at creation.**
  ///
  /// Part of the same snapshot as the tier above, and for a stronger reason.
  /// Re-pricing a tier changes what the next customer pays; re-deriving the
  /// CLOUD would send a terminate order to the wrong provider — which answers
  /// "no such instance", the platform marks the machine gone, and the real
  /// machine keeps running and keeps billing with nothing watching it.
  ///
  /// So an admin moving a model from AWS to Google tomorrow changes where the
  /// NEXT deployment goes and nothing else. Everything already running reads
  /// this column, via `cloudRouter.cloudOf()`, which takes no settings
  /// argument at all so that re-deriving is impossible rather than merely
  /// discouraged.
  ///
  /// Null on every deployment created before this existed, and the honest
  /// answer for those is the manual queue — which is where they were being
  /// fulfilled from anyway.
  cloudProvider String? @map("cloud_provider")

  // A machine the customer assembled in the builder rather than picked off the
  // catalogue. `tierId` is null for these — but it is also null when a
  // catalogue tier was deleted, so the flag is what distinguishes the two.
  // `tierCustomBuild` holds the parts list the admin has to provision from,
  // since no catalogue row will ever reconstruct it.
  tierIsCustom    Boolean @default(false) @map("tier_is_custom")
  tierCustomBuild Json?   @map("tier_custom_build")

  region String @default("default")

  // Rate frozen at order time — catalog price changes never affect a live deployment
  pricePerHour        Decimal @map("price_per_hour") @db.Decimal(12, 4)
  stoppedPricePerHour Decimal @default(0) @map("stopped_price_per_hour") @db.Decimal(12, 4)
  planDiscountPercent Decimal @default(0) @map("plan_discount_percent") @db.Decimal(5, 2)
  currency            String  @default("USD")

  billingMethod        BillingMethod                    @default(prepaid) @map("billing_method")
  billingMethodHistory DeploymentBillingMethodHistory[] @relation("DeploymentBillingMethodHistories")

  requirements DeploymentRequirement[] @relation("DeploymentRequirements")

  // ── sizing{} — what the recommendation engine advised at order time.
  // Always recomputed server-side, never accepted from the client. ──
  sizingJourneyKey             String    @default("") @map("sizing_journey_key")
  sizingRecommendedTierId      String?   @map("sizing_recommended_tier_id") @db.Uuid
  sizingRecommendedTier        Tier?     @relation("DeploymentSizingRecommendedTier", fields: [sizingRecommendedTierId], references: [id], onDelete: SetNull)
  sizingRecommendedTierName    String    @default("") @map("sizing_recommended_tier_name")
  sizingFollowedRecommendation Boolean?  @map("sizing_followed_recommendation")
  sizingRequirementProfile     Json?     @map("sizing_requirement_profile")
  sizingReasons                Json?     @map("sizing_reasons")
  sizingSuitabilityVerdict     String    @default("") @map("sizing_suitability_verdict")
  sizingConfidence             String    @default("") @map("sizing_confidence")
  sizingComputedAt             DateTime? @map("sizing_computed_at")

  status        DeploymentStatus          @default(pending_review)
  statusHistory DeploymentStatusHistory[] @relation("DeploymentStatusHistories")

  // ── endpoint{} — delivery / access control ──
  endpointUrl                     String    @default("") @map("endpoint_url")
  endpointApiKeyEncrypted         String    @default("") @map("endpoint_api_key_encrypted")
  endpointApiKeyMasked            String    @default("") @map("endpoint_api_key_masked")
  endpointDocsUrl                 String    @default("") @map("endpoint_docs_url")
  endpointExtra                   Json?     @map("endpoint_extra")
  endpointActive                  Boolean   @default(true) @map("endpoint_active")
  endpointKeyVersion              Int       @default(1) @map("endpoint_key_version")
  endpointSuspendedAt             DateTime? @map("endpoint_suspended_at")
  endpointSuspendReason           String    @default("") @map("endpoint_suspend_reason")
  endpointSuspendedForEnforcement Boolean   @default(false) @map("endpoint_suspended_for_enforcement")
  endpointRevokedAt               DateTime? @map("endpoint_revoked_at")
  endpointRevokeReason            String    @default("") @map("endpoint_revoke_reason")
  endpointShutdownRequired        Boolean   @default(false) @map("endpoint_shutdown_required")
  endpointShutdownRequestedAt     DateTime? @map("endpoint_shutdown_requested_at")
  endpointShutdownCompletedAt     DateTime? @map("endpoint_shutdown_completed_at")
  endpointShutdownCompletedById   String?   @map("endpoint_shutdown_completed_by_id") @db.Uuid
  endpointShutdownCompletedBy     User?     @relation("DeploymentShutdownCompletedBy", fields: [endpointShutdownCompletedById], references: [id], onDelete: SetNull)

  adminNotes      String  @default("") @map("admin_notes")
  rejectionReason String  @default("") @map("rejection_reason")

  /**
   * Why this order is waiting, in words the customer reads.
   *
   * Separate from `rejectionReason`, which means an admin turned the order
   * down and it is over. This one means the opposite: the order stands, the
   * platform cannot fill it yet, and the customer has something to decide.
   *
   * The case it was built for is a price that moved. A customer is quoted a
   * rate, and between the quote and the build the cloud raises its own — so
   * the machine would now earn less than this platform is set to need. The
   * order is not wrong and the customer did nothing; the price is ours to fix,
   * usually within the hour.
   *
   * Saying nothing was the worse option. The customer saw "under review" with
   * no reason and no end to it, and the only way out was to give up.
   */
  holdReason String @default("") @map("hold_reason")

  /// 'repricing' | 'capacity' | 'funds' | '' — what KIND of wait this is, so
  /// the screen can offer the right way forward rather than one generic line.
  holdKind String @default("") @map("hold_kind")

  /// When the hold was placed, so the customer can be told how long it has
  /// been and the screen can stop promising "within the hour" after an hour.
  heldAt DateTime? @map("held_at")
  assignedToId    String? @map("assigned_to_id") @db.Uuid
  assignedTo      User?   @relation("DeploymentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // ── timestamps for the billing engine ──
  provisionedAt DateTime? @map("provisioned_at")
  startedAt     DateTime? @map("started_at")
  lastBilledAt  DateTime? @map("last_billed_at")
  stoppedAt     DateTime? @map("stopped_at")
  terminatedAt  DateTime? @map("terminated_at")

  /**
   * When the compute meter started, because a real machine started.
   * Billing on this platform has always meant `status === 'running'`. That
   * worked while a human built the machine and flipped the status in the same
   * minute. With automatic provisioning the two come apart: GCP reports the VM
   * RUNNING, and the deployment stays `provisioning` until the model inside it
   * is configured — which can be a long time on a large model. The platform is
   * paying Google for every minute of that gap.
   * So the meter follows the hardware, not the promise. This is set from GCP's
   * own timestamp when the instance reaches RUNNING, and cleared when it stops.
   * While it is set, the deployment bills at the compute rate whatever its
   * status says.
   * It is also the guard on the oldest line in `transition()`: moving to
   * `running` sets `lastBilledAt = now`, which would write off every hour
   * already run. That line now only fires when this is null.
   * Null on every row that existed before automatic provisioning, which is why
   * introducing it changes nothing until a VM exists.
   */
  computeClockStartedAt DateTime? @map("compute_clock_started_at")

  totalRuntimeHours Decimal @default(0) @map("total_runtime_hours") @db.Decimal(14, 4)
  totalCost         Decimal @default(0) @map("total_cost") @db.Decimal(14, 4)

  autoSuspendedForCredit      Boolean   @default(false) @map("auto_suspended_for_credit")
  debtLimitSuspended          Boolean   @default(false) @map("debt_limit_suspended")
  hasUnpaidStorage            Boolean   @default(false) @map("has_unpaid_storage")
  storageDebtNotifiedAt       DateTime? @map("storage_debt_notified_at")
  paygOfferedAt               DateTime? @map("payg_offered_at")
  cardGateSuspended           Boolean   @default(false) @map("card_gate_suspended")
  storageGraceWarnedAt        DateTime? @map("storage_grace_warned_at")
  staleProvisioningNotifiedAt DateTime? @map("stale_provisioning_notified_at")

  // Client-minted key so a double-click/retry lands on the same deployment.
  // Scoped per-user, not globally unique.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usage DeploymentUsage[] @relation("DeploymentUsageDeployment")

  // The real machine, once there is one. Nullable because a deployment exists
  // before anything is provisioned, and because the manual driver never
  // creates one at all.
  cloudInstance DeploymentInstance? @relation("DeploymentCloudInstance")

  // A partial unique index on (userId, idempotencyKey) would apply only when
  // idempotencyKey was set. No manual SQL edit needed here, unlike
  // RecommendationPolicy.isActive below: Postgres already treats every NULL
  // in a unique constraint as distinct from every other NULL (including other
  // NULLs), so two rows for the same user with no idempotencyKey never
  // conflict — a plain compound unique already gives the same
  // behavior as long as the app keeps writing `null`, not `""`, when there is
  // no key (matching the source schema's own `default: null`).
  @@unique([userId, idempotencyKey])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([modelId])
  @@index([tierId])
  @@index([createdAt(sort: Desc)], map: "deployments_created_at_idx")
  @@index([startedAt(sort: Desc)], map: "deployments_started_at_idx")
  @@index([terminatedAt(sort: Desc)], map: "deployments_terminated_at_idx")
  @@index([tierId, status], map: "deployments_tier_id_status_idx")
  /**
   * Custom-build demand is read by expanding this JSON with
   * `jsonb_array_elements`, so the containment operators need a GIN index.
   * `jsonb_path_ops` rather than the default `jsonb_ops`: it indexes paths
   * instead of every key and value, which is a fraction of the size and is all
   * a containment query uses.
   */
  @@index([tierCustomBuild(ops: JsonbPathOps)], map: "deployments_tier_custom_build_gin_idx", type: Gin)
  @@map("deployments")
}

// Timestamped status-change log — a child row of its deployment.
model DeploymentStatusHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  deploymentId String     @map("deployment_id") @db.Uuid
  deployment   Deployment @relation("DeploymentStatusHistories", fields: [deploymentId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  status DeploymentStatus
  at     DateTime         @default(now())

  byId   String? @map("by_id") @db.Uuid
  by     User?   @relation("DeploymentStatusHistoryBy", fields: [byId], references: [id], onDelete: SetNull)
  byName String  @default("") @map("by_name")
  note   String  @default("")

  @@index([deploymentId, order])
  @@index([status, at(sort: Desc)], map: "deployment_status_history_status_at_idx")
  @@map("deployment_status_history")
}

// Every switch of funding method, kept as a history rather than just the
// current value. Unlike its sibling history tables, this sub-schema was
// declared WITHOUT `{ _id: false }` in the source, so each entry did have a
// its own id, because it is addressed directly.
model DeploymentBillingMethodHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  deploymentId String     @map("deployment_id") @db.Uuid
  deployment   Deployment @relation("DeploymentBillingMethodHistories", fields: [deploymentId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  method BillingMethod
  at     DateTime      @default(now())

  actorId   String? @map("actor_id") @db.Uuid
  actor     User?   @relation("DeploymentBillingMethodHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String  @default("") @map("actor_name")
  reason    String  @default("")

  @@index([deploymentId, order])
  @@map("deployment_billing_method_history")
}

// Answers to the admin-defined questionnaire, copied onto the deployment at
// order time — a child row of its deployment.
model DeploymentRequirement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  deploymentId String     @map("deployment_id") @db.Uuid
  deployment   Deployment @relation("DeploymentRequirements", fields: [deploymentId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  questionKey String @map("question_key")
  question    String @default("")
  type        String @default("text")
  answer      Json?

  @@index([deploymentId, order])
  @@map("deployment_requirements")
}

// One hourly billing tick for a deployment. Append-only — createdAt only, no
// updatedAt.
model DeploymentUsage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  deploymentId String     @map("deployment_id") @db.Uuid
  deployment   Deployment @relation("DeploymentUsageDeployment", fields: [deploymentId], references: [id])

  // The account billed.
  teamId String @map("team_id") @db.Uuid
  team   Team   @relation("DeploymentUsageTeam", fields: [teamId], references: [id])

  // The deployment's creator, copied at billing time — per-member spend.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("DeploymentUsageUser", fields: [userId], references: [id])

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  kind   DeploymentUsageKind @default(compute)
  status String              @default("")

  hours    Decimal @db.Decimal(10, 4)
  rate     Decimal @db.Decimal(12, 4)
  amount   Decimal @db.Decimal(12, 4)
  currency String  @default("USD")

  // How `amount` was actually funded — split so a PAYG deployment's ledger
  // tells the truth about where the money came from.
  toWallet Decimal @default(0) @map("to_wallet") @db.Decimal(12, 4)
  toDebt   Decimal @default(0) @map("to_debt") @db.Decimal(12, 4)

  transactionId     String?            @map("transaction_id") @db.Uuid
  transaction       CreditTransaction? @relation("DeploymentUsageTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  debtTransactionId String?            @map("debt_transaction_id") @db.Uuid
  debtTransaction   CreditTransaction? @relation("DeploymentUsageDebtTransaction", fields: [debtTransactionId], references: [id], onDelete: SetNull)

  charged Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([deploymentId, periodStart(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)], map: "deployment_usages_created_at_idx")
  @@index([periodStart(sort: Desc)], map: "deployment_usages_period_start_idx")
  @@index([kind, periodStart(sort: Desc)], map: "deployment_usages_kind_period_start_idx")
  /**
   * `(team_id, created_at)` above is the customer center's read. Reports filter
   * on `period_start` — the hour the usage covers rather than the hour the row
   * was written — and the two differ whenever the billing job catches up late.
   */
  @@index([teamId, periodStart(sort: Desc)], map: "deployment_usages_team_id_period_start_idx")
  @@map("deployment_usages")
}

/**
 * The real cloud machine behind a deployment.
 * ── Why a separate table rather than columns on Deployment ──
 * `Deployment` already carries about seventy columns, and its service layer is
 * a hand-rolled ORM: a new column there has to be added in three places
 * (`toDeploymentDoc`, the `save()` data object, and `createDeployment`) or it
 * silently never round-trips. Seventeen more columns through that path is
 * seventeen chances to miss one.
 * The decisive reason is concurrency, though. `wrapped.save()` writes every
 * column from an in-memory snapshot, so two code paths touching one deployment
 * clobber each other. The reconciler writes to this row every minute while a
 * customer may be pausing or renaming the deployment in the same second. On its
 * own table those writes are narrow, guarded `UPDATE`s that cannot overwrite
 * anything the customer just changed.
 * ── One row per deployment, kept after the machine is gone ──
 * `deploymentId` is unique: a deployment has one machine at a time. When that
 * machine is destroyed the row stays with `phase = terminated` and `deletedAt`
 * set, rather than being deleted. A tombstone is what lets the orphan sweep
 * tell "this instance was ours and we destroyed it" from "this instance is ours
 * and nobody knows about it" — and the second of those is the one quietly
 * costing money.
 */
model DeploymentInstance {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  deploymentId String     @unique @map("deployment_id") @db.Uuid
  deployment   Deployment @relation("DeploymentCloudInstance", fields: [deploymentId], references: [id], onDelete: Cascade)

  /**
   * Which cloud, and which project inside it.
   * `projectId` is stored per instance rather than read from settings at use
   * time, for two reasons. A machine created in one project must still be
   * findable after an admin points the platform at a different one — otherwise
   * it becomes an orphan nobody can see. And it keeps project-per-customer a
   * configuration change later rather than a schema migration: the isolation
   * design notes that a shared project is the one place the current design
   * asks to be trusted rather than proving itself.
   */
  provider  String @default("gcp")
  projectId String @map("project_id")
  zone      String

  // Derived from the deployment id, so GCP's own per-zone uniqueness is what
  // stops a double-fire creating two machines for one order.
  instanceName String  @map("instance_name")
  // GCP's numeric id, assigned on creation. A string because it exceeds 2^53.
  instanceId   String? @map("instance_id")

  // What was actually built, not what was asked for — the two differ whenever
  // GCP has no shape matching a tier exactly, and the admin screen shows both.
  machineType      String  @map("machine_type")
  acceleratorType  String? @map("accelerator_type")
  acceleratorCount Int     @default(0) @map("accelerator_count")
  bootDiskType     String  @default("") @map("boot_disk_type")
  bootDiskSizeGb   Int     @default(0) @map("boot_disk_size_gb")

  // No external IP is the design (see infra/README.md); the column exists so a
  // machine that somehow has one is visible rather than invisible.
  internalIp String? @map("internal_ip")
  externalIp String? @map("external_ip")

  phase CloudInstancePhase @default(planned)

  /**
   * The open long-running operation, if any.
   * `instances.insert` returns immediately with an operation that takes 30-90
   * seconds. There is no queue in this platform, so the reconciler polls: it
   * finds rows with an operation still open and asks GCP how they went. Storing
   * the operation name is also what makes a crash between "GCP accepted" and
   * "we wrote it down" recoverable.
   */
  operationName String?   @map("operation_name")
  operationType String?   @map("operation_type")
  operationAt   DateTime? @map("operation_at")

  /**
   * Retry bookkeeping, in the "due and not yet done" shape this codebase uses
   * everywhere else (see services/billing/collectionSchedule.js). The
   * reconciler asks "what is due", never "is it time yet", so a run that comes
   * late does the work the missed run should have done.
   */
  attempt       Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")

  lastErrorCode String?   @map("last_error_code")
  lastError     String?   @map("last_error")
  lastErrorAt   DateTime? @map("last_error_at")

  // What the spec mapper decided and why, kept verbatim. When a customer asks
  // why they got 12 vCPU after buying 16, this is the answer — and it is the
  // only record of it, because the mapper is pure and keeps nothing.
  specPlan Json? @map("spec_plan")

  // Written only from GCP's own timestamps, never from our clock: the
  // reconciler may notice a machine minutes after it started, and billing from
  // when we noticed would charge the customer for our polling interval.
  requestedAt DateTime  @default(now()) @map("requested_at")
  runningAt   DateTime? @map("running_at")
  stoppedAt   DateTime? @map("stopped_at")
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The reconciler's own query: everything in a phase that still has work to
  // do, ordered by when it is next due.
  @@index([phase, nextAttemptAt])
  // The orphan sweep goes the other way — from a name GCP reported back to us.
  @@index([provider, projectId, zone, instanceName], map: "deployment_instances_provider_location_idx")
  @@index([phase, runningAt], map: "deployment_instances_phase_running_at_idx")
  @@map("deployment_instances")
}

/**
 * A machine on GCP that this platform created and can no longer account for.
 * Found by the orphan sweep: it lists every instance labelled `managed-by=aiocean`
 * and compares that against the deployments it believes exist. Anything on the
 * cloud side with no live counterpart is charging the platform by the hour for
 * nothing, and the only thing worse than one of these is one nobody has written
 * down.
 * Kept as a record rather than acted on automatically. Deleting a machine
 * because our own bookkeeping lost track of it is exactly the operation that
 * should not be automatic — a bug in the sweep would then destroy live
 * customer workloads. The sweep raises it, an admin confirms it.
 */
model OrphanInstance {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  provider     String  @default("gcp")
  projectId    String  @map("project_id")
  zone         String
  instanceName String  @map("instance_name")
  instanceId   String? @map("instance_id")

  machineType String @default("") @map("machine_type")
  labels      Json?
  // What GCP says it is doing, so an admin can tell a running machine from one
  // that is already stopped and merely holding a disk.
  cloudStatus String @default("") @map("cloud_status")

  // Why the sweep thinks nobody owns it: no deployment row at all, the
  // deployment is terminated, or it was never ours to begin with.
  reason String @default("")

  // The deployment this looks like it belonged to, when the name still decodes
  // to one. Not a foreign key: the whole point is that the row may be gone.
  suspectedDeploymentId String? @map("suspected_deployment_id") @db.Uuid

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  // Set when an admin decides. Nothing here is destroyed without that.
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedBy   User?     @relation("OrphanInstanceResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String    @default("") // destroyed | kept | not_ours

  @@unique([provider, projectId, zone, instanceName], map: "orphan_instances_identity_key")
  @@index([resolvedAt])
  @@map("orphan_instances")
}

// ============================================================================
// ==== Admin domain ====
// ============================================================================

// Append-only — createdAt only, no updatedAt. `userId` is onDelete: Restrict:
// an audit trail must never silently lose its link, same reasoning as
// CreditTransaction (flagged for human review — the plan only calls this out
// explicitly for CreditTransaction, this is an extension of that reasoning).
// `userName`/`userEmail`/`userRole` are a deliberate denormalized snapshot.
// `action` (~80 values) and `targetModel` (polymorphic, paired with
// `targetId`) stay plain String per the plan; `actionType` and `status` are
// small stable vocabularies and become real enums.
model ActivityLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  user      User   @relation("ActivityLogUser", fields: [userId], references: [id], onDelete: Restrict)
  userName  String @map("user_name")
  userEmail String @map("user_email")
  userRole  String @map("user_role")

  action     String
  actionType ActivityLogActionType @map("action_type")

  targetModel String? @map("target_model")
  targetId    String? @map("target_id")
  targetName  String? @map("target_name")

  description String
  metadata    Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  status       ActivityLogStatus @default(success)
  errorMessage String?           @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([targetModel, targetId])
  /**
   * Active users and logins are read as "customers, over this date range".
   * None of the indexes above lead with `user_role`, so that read was a
   * sequential scan of the largest table on the platform bar usage.
   */
  @@index([userRole, createdAt(sort: Desc)], map: "activity_logs_user_role_created_at_idx")
  @@map("activity_logs")
}

// Singleton — enforced by the `isSingleton @unique @default(true)` pattern
// below, a real DB-enforced at-most-one-row guarantee replacing today's
// app-only `getSettings()` convention. Each config section collapses to one
// Json column; `activePaymentGateway` stays its own enum column since app
// code branches on it directly (see the pinned admin-center-controlled-
// features note — this is the field that switches Stripe vs LemonSqueezy
// platform-wide). Section columns are nullable Json — the app is expected to
// populate them with the shipped defaults the first time the singleton row
// is created, mirroring today's `getSettings()` seeding behavior.
model AdminSettings {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  isSingleton Boolean @unique @default(true) @map("is_singleton")

  themeSettings Json? @map("theme_settings")

  siteName        String @default("My Platform") @map("site_name")
  siteDescription String @default("AI-powered platform") @map("site_description")
  supportEmail    String @default("support@example.com") @map("support_email")
  contactEmail    String @default("contact@example.com") @map("contact_email")

  emailSettings        Json? @map("email_settings")
  emailTemplates       Json? @map("email_templates")
  customerSettings     Json? @map("customer_settings")
  securitySettings     Json? @map("security_settings")
  analyticsSettings    Json? @map("analytics_settings")
  notificationSettings Json? @map("notification_settings")
  stripeSettings       Json? @map("stripe_settings")
  lemonSqueezySettings Json? @map("lemon_squeezy_settings")
  polarSettings        Json? @map("polar_settings")

  activePaymentGateway PaymentGateway @default(stripe) @map("active_payment_gateway")

  maintenanceMode    Json? @map("maintenance_mode")
  seoSettings        Json? @map("seo_settings")
  billingSettings    Json? @map("billing_settings")
  deploymentSettings Json? @map("deployment_settings")
  // Google Cloud provisioning. Holds the service-account key ENCRYPTED (see
  // gcpSettingsController) — the only secret on this platform stored that way,
  // because it can create and destroy machines that cost money by the hour.
  gcpSettings        Json? @map("gcp_settings")

  /// Overhead, tax and margin — what the platform adds on top of a provider's
  /// charge to get the true cost of a machine-hour. See services/cloud/costModel.js.
  /// Amazon Web Services. Same shape as gcpSettings, field for field where
  /// the two clouds share a concept.
  awsSettings Json? @map("aws_settings")

  /// Which cloud wins when more than one is on and a model is not assigned.
  /// See services/cloud/cloudRouter.js.
  cloudRoutingSettings Json? @map("cloud_routing_settings")

  cloudPricingSettings Json? @map("cloud_pricing_settings")
  features           Json?
  googleSSOSettings  Json? @map("google_sso_settings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

