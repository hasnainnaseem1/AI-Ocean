/**
 * A customer's support ticket, and its own message thread.
 * Belongs to the User who raised it, never to a Team — this is a person
 * asking a question, not something an account's money touches, so it carries
 * none of the team-context machinery the rest of the customer API runs
 * through.
 * `number` is a plain sequential integer purely for display ("TCK-1001"), kept
 * separate from `id` (the real primary key everything else joins on) the same
 * way every other resource in this app keeps its public id apart from its
 * internal one.
 * `assignedAdminId` is nullable and `SetNull` on delete, with the admin's name
 * denormalised alongside it — the same shape `CustomerNote.authorId` /
 * `authorName` already uses just above, for the same reason: an assignment
 * must survive the assigned admin's account later being removed.
 */
model SupportTicket {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number Int    @unique @default(autoincrement())

  userId String @map("user_id") @db.Uuid
  user   User   @relation("SupportTicketUser", fields: [userId], references: [id])

  subject String

  // Both plain strings, not enums — a small, fixed, admin-facing vocabulary
  // the same way `Notification.type` is (see that model's comment). Valid
  // values are enforced by a CHECK constraint in the migration, not by Prisma.
  category String
  status   String @default("open")

  /**
   * How urgent this ticket is, and therefore which SLA it is graded against.
   * Set by support, not by the customer: a priority the person in a hurry
   * chooses themselves is a field where everything is urgent. The vocabulary
   * is the key set of `AnalyticsPolicy.support.sla`, so adding a tier is a
   * policy edit rather than a migration. A CHECK constraint keeps the column
   * honest; `AnalyticsPolicy` decides what each tier *means*.
   */
  priority String @default("normal")

  /**
   * ── Why these timestamps exist at all ──
   * `updatedAt` moves when a ticket is assigned, renamed or re-prioritised, so
   * "resolved at" read from it is a lie that happens to be right sometimes.
   * These columns are written only by the transitions they describe.
   * `firstResponseAt` is the first message from support — the number a
   * customer actually feels. `resolvedAt` is the most recent transition INTO
   * solved, so a ticket reopened and solved again reports the second one, and
   * `resolutionMinutes` is measured from `createdAt` to that point: the whole
   * time the customer waited, reopens included, not the last leg only.
   */
  firstResponseAt   DateTime? @map("first_response_at")
  resolvedAt        DateTime? @map("resolved_at")
  resolutionMinutes Int?      @map("resolution_minutes")

  /**
   * True where `resolvedAt` was back-filled from `updatedAt` by the migration
   * that added these columns, because the real timestamp was never recorded.
   * It is an estimate and every chart that uses it says so — an SLA figure
   * that is partly guessed and does not admit it is worse than none.
   */
  resolvedAtEstimated Boolean @default(false) @map("resolved_at_estimated")

  // Times this ticket went from solved back to open. Not back-fillable: the
  // old schema kept no record of a status ever changing, and a customer
  // message cannot be told from the message that merely followed a pending
  // reply. Counted forward from instrumentation; the analytics say from when.
  reopenedCount Int @default(0) @map("reopened_count")

  /**
   * The SLA targets in force WHEN THIS TICKET OPENED, copied onto the row.
   * Deliberately snapshotted rather than looked up at read time. An operator
   * who tightens the first-response target next month must not thereby turn
   * last month's answered-in-time tickets into breaches — the queue would
   * appear to have failed retroactively at work nobody did wrong. Re-stamped
   * if the priority changes, because the ticket is then a different promise.
   */
  slaFirstResponseMinutes Int? @map("sla_first_response_minutes")
  slaResolutionMinutes    Int? @map("sla_resolution_minutes")

  assignedAdminId   String? @map("assigned_admin_id") @db.Uuid
  assignedAdmin     User?   @relation("SupportTicketAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAdminName String? @map("assigned_admin_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Bumped on every new message, in either direction — what an admin queue
  // sorts "most recently active" by, distinct from `createdAt` (when the
  // ticket was opened) and `updatedAt` (which a status-only change also touches).
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  messages      SupportTicketMessage[]       @relation("SupportTicketMessages")
  statusHistory SupportTicketStatusHistory[] @relation("SupportTicketStatusHistories")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([createdAt(sort: Desc)], map: "support_tickets_created_at_idx")
  @@index([status, priority], map: "support_tickets_status_priority_idx")
  @@index([assignedAdminId, status], map: "support_tickets_assigned_status_idx")
  @@index([resolvedAt(sort: Desc)], map: "support_tickets_resolved_at_idx")
  @@map("support_tickets")
}

/**
 * Every status a ticket has held, who moved it and when.
 * The same shape as `DeploymentStatusHistory`, for the same reason: a column
 * that is overwritten in place can answer "what is it now" and nothing else.
 * Without this there is no honest way to say how long a ticket sat waiting, how
 * often support reopened its own work, or whether last Tuesday's queue was
 * really as bad as it felt.
 * `backfilled` marks the two rows the migration invented for each pre-existing
 * ticket — an `open` at `created_at` (exact) and, for a solved one, a `solved`
 * at `updated_at` (a guess). It is what lets the analytics say "reopens are
 * counted from <date>" instead of reporting zero reopens as if it were a fact.
 */
model SupportTicketStatusHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ticketId String        @map("ticket_id") @db.Uuid
  ticket   SupportTicket @relation("SupportTicketStatusHistories", fields: [ticketId], references: [id], onDelete: Cascade)

  status String
  at     DateTime @default(now())

  // 'customer' | 'admin' | 'system' — who caused it. A ticket reopened by the
  // customer and one reopened by support are different events.
  byType String  @map("by_type")
  byId   String? @map("by_id") @db.Uuid
  by     User?   @relation("SupportTicketStatusHistoryBy", fields: [byId], references: [id], onDelete: SetNull)
  byName String  @default("") @map("by_name")

  note String @default("")

  backfilled Boolean @default(false)

  @@index([ticketId, at(sort: Asc)])
  @@index([status, at(sort: Desc)], map: "support_ticket_status_history_status_at_idx")
  @@map("support_ticket_status_history")
}

/**
 * One message in a ticket's thread, from either side of it.
 * `authorId` is nullable + `SetNull`, with `authorName` denormalised — the
 * `CustomerNote.authorId` pattern again — because a message must stay
 * readable, and attributable, after the person who wrote it (customer or
 * admin) is no longer an account on the platform.
 */
model SupportTicketMessage {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String        @map("ticket_id") @db.Uuid
  ticket   SupportTicket @relation("SupportTicketMessages", fields: [ticketId], references: [id], onDelete: Cascade)

  // 'customer' | 'admin' — enforced by a CHECK constraint, not by Prisma.
  authorType String  @map("author_type")
  authorId   String? @map("author_id") @db.Uuid
  author     User?   @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String  @map("author_name")

  body String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt(sort: Asc)])
  // Agent load: "who answered how many tickets this week" is a platform-wide
  // read over author, which the ticket-leading index above cannot serve.
  @@index([authorType, createdAt(sort: Desc)], map: "support_ticket_messages_author_type_created_at_idx")
  @@map("support_ticket_messages")
}

